@page "/login"
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Sign In — NekiConnect</PageTitle>

<style>
    .pg { background: #f8fdf9; min-height: 100vh; padding-bottom: 40px; }
    .nav { display:flex; align-items:center; justify-content:space-between; padding:13px 28px; background:#fff; border-bottom:1px solid #e5e7eb; }
    .brand { display:flex; align-items:center; gap:8px; font-size:16px; font-weight:600; color:#111; text-decoration:none; }
    .bico { width:30px; height:30px; background:#16a34a; border-radius:8px; display:flex; align-items:center; justify-content:center; }
    .brand em { color:#16a34a; font-style:italic; }
    .nlinks { display:flex; align-items:center; gap:22px; font-size:13px; }
    .nlinks a { color:#374151; text-decoration:none; font-weight:500; }
    .nlinks a:hover { color:#16a34a; }
    .btn-ghost { font-size:13px; color:#374151; background:none; border:none; cursor:pointer; padding:7px 10px; font-weight:500; font-family:inherit; }
    .btn-green { background:#16a34a; color:#fff; border:none; padding:8px 18px; border-radius:8px; font-size:13px; font-weight:600; cursor:pointer; font-family:inherit; }
    .btn-green:hover { background:#15803d; }
    .page-body { display:flex; flex-direction:column; align-items:center; padding:44px 16px 0; }
    .pico { width:52px; height:52px; background:#16a34a; border-radius:13px; display:flex; align-items:center; justify-content:center; margin-bottom:14px; }
    .ptitle { font-size:24px; font-weight:700; color:#111; margin-bottom:4px; }
    .psub { font-size:13px; color:#6b7280; margin-bottom:26px; }
    .card { background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:26px 28px 24px; width:100%; max-width:420px; box-shadow:0 1px 12px rgba(0,0,0,.05); }
    .rl { font-size:10px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:#9ca3af; margin-bottom:9px; }
    .tabs { display:flex; background:#f1f5f1; border-radius:10px; padding:3px; margin-bottom:22px; gap:2px; }
    .tab-btn { flex:1; padding:8px 6px; border:none; border-radius:8px; font-size:13px; font-weight:600; cursor:pointer; background:transparent; color:#6b7280; font-family:inherit; transition:all .18s; }
    .tab-btn.active { background:#fff; color:#16a34a; border:1px solid #d1fae5; }
    .fg { margin-bottom:14px; }
    .fg label { display:block; font-size:12px; font-weight:600; color:#374151; margin-bottom:5px; }
    .fg input { width:100%; padding:10px 13px; border:1.5px solid #e5e7eb; border-radius:9px; font-size:13px; color:#111; background:#fff; outline:none; box-sizing:border-box; font-family:inherit; }
    .fg input:focus { border-color:#16a34a; box-shadow:0 0 0 3px rgba(22,163,74,.08); }
    .fg input.invalid { border-color:#ef4444; }
    .fg input.valid   { border-color:#16a34a; }
    .pwd-label-row { display:flex; justify-content:space-between; align-items:center; margin-bottom:5px; }
    .pwd-label-row label { font-size:12px; font-weight:600; color:#374151; }
    .forgot-link { font-size:12px; color:#16a34a; text-decoration:none; font-weight:500; }
    .pwd-wrap { position:relative; }
    .pwd-wrap input { padding-right:40px; width:100%; box-sizing:border-box; }
    .eye-btn { position:absolute; right:11px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:#9ca3af; padding:2px; display:flex; align-items:center; }
    .eye-btn:hover { color:#16a34a; }
    .submit-btn { width:100%; padding:11px; border:none; border-radius:9px; font-size:15px; font-weight:600; background:#16a34a; color:#fff; cursor:pointer; margin-bottom:16px; font-family:inherit; }
    .submit-btn:hover { background:#15803d; }
    .slink { text-align:center; font-size:13px; color:#6b7280; }
    .slink a { color:#16a34a; font-weight:600; text-decoration:none; }
    .ssl-note { text-align:center; font-size:11px; color:#9ca3af; margin-top:18px; }
    .alert-err { background:#fef2f2; border:1px solid #fecaca; border-radius:8px; padding:10px 13px; font-size:12px; color:#dc2626; margin-bottom:14px; }
    .admin-hint { background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px; padding:9px 12px; font-size:11.5px; color:#166534; margin-bottom:14px; }
    .portal-hint { background:#eff6ff; border:1px solid #bfdbfe; border-radius:8px; padding:9px 12px; font-size:11.5px; color:#1d4ed8; margin-bottom:14px; }
</style>

<div class="pg">
    <nav class="nav">
        <a class="brand" href="/">
            <div class="bico">
                <svg width="16" height="16" fill="white" viewBox="0 0 24 24">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
            </div>
            Neki<em>Connect</em>
        </a>
        <div class="nlinks">
            <a href="/campaigns">Campaigns</a>
            <a href="/fundraisings">Fundraising</a>
            <a href="/blogs">Blogs</a>
        </div>
        <div style="display:flex;align-items:center;gap:8px">
            <button class="btn-ghost">Login</button>
            <button class="btn-green" @onclick='() => Navigation.NavigateTo("/register")'>Register</button>
        </div>
    </nav>

    <div class="page-body">
        <div class="pico">
            <svg width="26" height="26" fill="white" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
        </div>
        <h1 class="ptitle">Welcome back</h1>
        <p class="psub">Sign in to your NekiConnect account</p>

        <div class="card">

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="alert-err">⚠ @errorMsg</div>
            }

            @* Show a hint when coming from a portal link *@
            @if (!string.IsNullOrEmpty(returnUrl) && string.IsNullOrEmpty(errorMsg))
            {
                <div class="portal-hint">
                    🔒 Please sign in to access the
                    <strong>@PortalName</strong>.
                </div>
            }

            @if (ActiveTab == "admin")
            {
                <div class="admin-hint">🔒 Admin portal — restricted access only.</div>
            }

            <p class="rl">Login as</p>
            <div class="tabs">
                <button type="button" class="tab-btn @(ActiveTab=="donor"?"active":"")" @onclick='()=>SwitchTab("donor")'>Donor</button>
                <button type="button" class="tab-btn @(ActiveTab=="ngo"  ?"active":"")" @onclick='()=>SwitchTab("ngo")'>NGO</button>
                <button type="button" class="tab-btn @(ActiveTab=="admin"?"active":"")" @onclick='()=>SwitchTab("admin")'>Admin</button>
            </div>

            <form method="post" action="/account/login">
                <input type="hidden" name="__RequestVerificationToken" value="@antiforgeryToken" />
                <input type="hidden" name="Role"      value="@RoleValue" />
                <input type="hidden" name="ReturnUrl" value="@returnUrl" />

                <div class="fg">
                    <label>Email Address</label>
                    <input class="@GetEmailClass()"
                           type="email" name="Email"
                           placeholder="you@example.com"
                           @bind="email" @bind:event="oninput"
                           required />
                </div>

                <div class="fg" style="margin-bottom:18px">
                    <div class="pwd-label-row">
                        <label>Password</label>
                        @if (ActiveTab != "admin")
                        {
                            <a class="forgot-link" href="/forgot-password">Forgot password?</a>
                        }
                    </div>
                    <div class="pwd-wrap">
                        <input class="@GetPwdClass()"
                               type="@(showPwd ? "text" : "password")"
                               name="Password"
                               placeholder="Enter your password"
                               @bind="password" @bind:event="oninput"
                               required />
                        <button type="button" class="eye-btn" @onclick="()=> showPwd = !showPwd">
                            @if (showPwd)
                            {
                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                                    <line x1="1" y1="1" x2="23" y2="23"/>
                                </svg>
                            }
                            else
                            {
                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            }
                        </button>
                    </div>
                </div>

                <button type="submit" class="submit-btn">Sign In →</button>
            </form>

            @if (ActiveTab != "admin")
            {
                <p class="slink">Don't have an account? <a href="/register">Register</a></p>
            }
        </div>

        <p class="ssl-note">🔒 Secured with 256-bit SSL encryption</p>
    </div>
</div>

@code {
    // Read query parameters set by the navbar portal links
    [SupplyParameterFromQuery] private string? error     { get; set; }
    [SupplyParameterFromQuery] private string? tab       { get; set; }
    [SupplyParameterFromQuery] private string? returnUrl { get; set; }

    [Inject] private Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery       { get; set; } = default!;
    [Inject] private IHttpContextAccessor                           HttpContextAccessor { get; set; } = default!;

    private string ActiveTab = "donor";
    private string email     = string.Empty;
    private string password  = string.Empty;
    private bool   showPwd   = false;
    private string antiforgeryToken = string.Empty;

    protected override void OnInitialized()
    {
        // Pre-select the tab based on which portal was clicked
        if (!string.IsNullOrEmpty(tab))
            ActiveTab = tab.ToLower() switch
            {
                "ngo"   => "ngo",
                "admin" => "admin",
                _       => "donor"
            };

        // Generate antiforgery token for the form
        var ctx = HttpContextAccessor.HttpContext;
        if (ctx != null)
        {
            var tokens = Antiforgery.GetAndStoreTokens(ctx);
            antiforgeryToken = tokens.RequestToken ?? string.Empty;
        }
    }

    // Human-readable portal name for the hint banner
    private string PortalName => returnUrl switch
    {
        "/ngo/dashboard"   => "NGO Dashboard",
        "/donor/dashboard" => "Donor Dashboard",
        "/admin"           => "Admin Panel",
        _                  => "portal"
    };

    private string RoleValue => ActiveTab == "donor" ? "Donor"
                              : ActiveTab == "ngo"   ? "NGO"
                              : "Admin";

    private string errorMsg => error switch
    {
        "invalid"       => "No account found with this email.",
        "wrongtab"      => "Wrong login tab — please select the correct role.",
        "suspended"     => "Your account has been suspended. Contact support.",
        "wrongpassword" => "Incorrect password. Please try again.",
        _               => string.Empty
    };

    private void SwitchTab(string t)
    {
        ActiveTab = t;
        email     = string.Empty;
        password  = string.Empty;
        showPwd   = false;
    }

    private string GetEmailClass()
    {
        if (string.IsNullOrEmpty(email)) return "";
        var at = email.IndexOf('@');
        if (at < 1) return "invalid";
        var domain = email[(at + 1)..];
        var dot    = domain.LastIndexOf('.');
        return (dot > 0 && domain.Length - dot >= 3) ? "valid" : "invalid";
    }

    private string GetPwdClass() =>
        string.IsNullOrEmpty(password) ? "" : password.Length >= 6 ? "valid" : "invalid";
}
