@page "/login"
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Sign In — NekiConnect</PageTitle>

<Navbar />

<div class="pg">
    <div class="page-body">

        <h1 class="ptitle">Welcome back</h1>
        <p class="psub">Sign in to your NekiConnect account</p>

        <div class="card">

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="alert-err">⚠ @errorMsg</div>
            }

            <p class="rl">Login as</p>

            <div class="tabs">
                <button type="button" class="tab-btn @(ActiveTab == "donor" ? "active" : "")"
                        @onclick='() => SwitchTab("donor")'>
                    Donor
                </button>
                <button type="button" class="tab-btn @(ActiveTab == "ngo" ? "active" : "")"
                        @onclick='() => SwitchTab("ngo")'>
                    NGO
                </button>
                <button type="button" class="tab-btn @(ActiveTab == "admin" ? "active" : "")"
                        @onclick='() => SwitchTab("admin")'>
                    Admin
                </button>
            </div>

            <form method="post" action="/account/login">
                <input type="hidden" name="Role" value="@ActiveTab" />

                <div class="fg">
                    <label>Email Address</label>
                    <input name="Email" type="email" required />
                </div>

                <div class="fg">
                    <label>Password</label>
                    <div class="pwd-wrap">
                        <input name="Password"
                               type="@(showPwd ? "text" : "password")"
                               required />
                        <button type="button"
                                class="eye-btn"
                                @onclick="() => showPwd = !showPwd"
                                tabindex="-1">
                            @if (showPwd)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                    <line x1="1" y1="1" x2="23" y2="23" />
                                </svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            }
                        </button>
                    </div>
                </div>

                <button type="submit" class="submit-btn">Sign In →</button>
            </form>

            @if (ActiveTab != "admin")
            {
                <p class="slink">Don't have an account? <a href="/register?tab=@ActiveTab">Register</a></p>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] private string? error { get; set; }

    private string ActiveTab = "donor";
    private bool showPwd = false;

    private string errorMsg => error switch
    {
        "invalid" => "No account found.",
        "wrongpassword" => "Wrong password.",
        "suspended" => "Account suspended.",
        "wrongtab" => "Wrong role selected.",
        "forbidden" => "You do not have access to that page.",
        "ngo_pending" => "Your NGO registration is under review. You'll be notified once approved.",
        "ngo_rejected" => "Your NGO registration was not approved. Please contact support.",        
        "ngo_not_found" => "No NGO profile found for this account.",   
        "ngo_suspended" => "Your NGO has been suspended. Please contact support for more information.",  
        _ => ""
    };

    private void SwitchTab(string t)
    {
        ActiveTab = t;
    }
}