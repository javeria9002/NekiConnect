@page "/ngo/volunteers"
@layout NgoLayout
@using NekiConnect.Models
@using NekiConnect.Services
@inject NGOService NgoService
@inject VolunteerService VolunteerService
@inject AuthenticationStateProvider AuthProvider
@attribute [Authorize(Roles = "NGO")]

<Navbar/>

<div class="vol-page">

    <h1 class="vol-title">Volunteer Applications</h1>
    <p class="vol-sub">Review and manage volunteer applications for your events.</p>

    <!-- Stat cards -->
    <div class="stat-row">
        <div class="stat-card amber">
            <div class="stat-ico amber">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
            </div>
            <div class="stat-num amber-t">@pendingCount</div>
            <div class="stat-lbl">Pending Review</div>
        </div>
        <div class="stat-card green">
            <div class="stat-ico green">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
            </div>
            <div class="stat-num green-t">@acceptedCount</div>
            <div class="stat-lbl">Accepted</div>
        </div>
        <div class="stat-card red">
            <div class="stat-ico red">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="15" y1="9" x2="9" y2="15" />
                    <line x1="9" y1="9" x2="15" y2="15" />
                </svg>
            </div>
            <div class="stat-num red-t">@rejectedCount</div>
            <div class="stat-lbl">Rejected</div>
        </div>
    </div>

    <!-- Awaiting banner -->
    @if (pendingCount > 0)
    {
        <div class="await-banner">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
            </svg>
            <span><strong>@pendingCount application(s)</strong> are awaiting your review.</span>
        </div>
    }

    <!-- Search + filters -->
    <div class="filter-bar">
        <div class="search-wrap">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input class="search-inp" placeholder="Search applicants..." @bind="search" @bind:event="oninput" />
        </div>
        <div class="filter-btns">
            @foreach (var f in new[] { "All", "Pending", "Accepted", "Rejected" })
            {
                <button class="fbtn @(filter == f ? "active" : "")" @onclick="() => filter = f">@f</button>
            }
        </div>
    </div>

    <!-- Applications -->
    @if (Filtered.Count == 0)
    {
        <div class="empty">No applications found.</div>
    }
    else
    {
        @foreach (var v in Filtered)
        {
            var name = v.User?.FullName ?? "Unknown";
            <div class="app-card @StatusBorder(v.Status)">
                <div class="app-left">
                    <div class="app-avatar">@(string.IsNullOrEmpty(name) ? "?" : name.Substring(0, 1).ToUpper())</div>
                    <div class="app-info">
                        <div class="app-name">@name</div>
                        <div class="app-email">@v.User?.Email</div>
                        <div class="app-meta">
                            <span>
                               <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-1px">
                                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                                    <line x1="16" y1="2" x2="16" y2="6"/>
                                    <line x1="8" y1="2" x2="8" y2="6"/>
                                    <line x1="3" y1="10" x2="21" y2="10"/>
                               </svg>
                               @(v.Campaign?.Title ?? v.Event?.Title ?? "—")
                            </span>
                            <span>
                               <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-1px">
                                   <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 1 1 18 0z"/>
                                   <circle cx="12" cy="10" r="3"/>
                               </svg>
                               @(v.Campaign?.Location ?? v.Event?.Location ?? "—")
                            </span>
                            <span>
                               @if (v.EventId.HasValue)
                               {
                                    <span style="background:#dbeafe;color:#1d4ed8;font-size:10px;font-weight:600;padding:2px 8px;border-radius:10px;">Event</span>
                               }
                               else
                               {
                                    <span style="background:#dcfce7;color:#15803d;font-size:10px;font-weight:600;padding:2px 8px;border-radius:10px;">Campaign</span>
                               }
                               <span class="applied">Applied: @v.AppliedAt.ToString("MMM d, yyyy")</span>
                            </span>
                            <span class="applied">Applied: @v.AppliedAt.ToString("MMM d, yyyy")</span>
                        </div>
                    </div>
                </div>

                <div class="app-actions">
                    @if (v.Status == "Pending")
                    {
                        <span class="badge badge-pending">Pending</span>
                        <button class="btn-accept" @onclick='() => UpdateStatus(v.Id, "Accepted")'>
                            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <polyline points="20 6 9 17 4 12" />
                            </svg>
                            Accept
                        </button>
                        <button class="btn-reject" @onclick='() => UpdateStatus(v.Id, "Rejected")'>
                            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <line x1="18" y1="6" x2="6" y2="18" />
                                <line x1="6" y1="6" x2="18" y2="18" />
                            </svg>
                            Reject
                        </button>
                    }
                    else if (v.Status == "Accepted")
                    {
                        <span class="badge badge-accepted">
                            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-2px">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                <polyline points="22 4 12 14.01 9 11.01" />
                            </svg>
                            Accepted
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-rejected">
                            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-2px">
                                <circle cx="12" cy="12" r="10" />
                                <line x1="15" y1="9" x2="9" y2="15" />
                                <line x1="9" y1="9" x2="15" y2="15" />
                            </svg>
                            Rejected
                        </span>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private NGO? ngo;
    private List<VolunteerApplication> apps = new();
    private string filter = "All";
    private string search = "";

    private int pendingCount => apps.Count(a => a.Status == "Pending");
    private int acceptedCount => apps.Count(a => a.Status == "Accepted");
    private int rejectedCount => apps.Count(a => a.Status == "Rejected");

    private List<VolunteerApplication> Filtered =>
        apps.Where(a => filter == "All" || a.Status == filter)
            .Where(a => string.IsNullOrWhiteSpace(search)
                     || (a.User?.FullName ?? "").Contains(search, StringComparison.OrdinalIgnoreCase)
                     || (a.User?.Email ?? "").Contains(search, StringComparison.OrdinalIgnoreCase))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId)) return;

        ngo = await NgoService.GetNGOByUserIdAsync(userId);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (ngo is null) return;
        apps = await VolunteerService.GetApplicationsByNgoIdAsync(ngo.Id);
    }

    private async Task UpdateStatus(int id, string status)
    {
        await VolunteerService.UpdateStatusAsync(id, status);
        await LoadAsync();
    }

    private static string StatusBorder(string status) => status switch
    {
        "Accepted" => "border-green",
        "Rejected" => "border-red",
        _ => "border-amber"
    };
}