@page "/ngo/dashboard"
@layout NgoLayout
@using NekiConnect.Models
@using NekiConnect.Services
@inject NGOService NgoService
@inject CampaignService CampaignService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@attribute [Authorize(Roles = "NGO")]

<Navbar/>

<div class="dash-page">

    @if (ngo is null)
    {
        <div class="empty-state">
            <p>No NGO profile linked to your account yet.</p>
        </div>
    }
    else
    {
        <!-- Breadcrumb -->
        <div class="crumb">
            <span class="crumb-muted">NGO Portal</span>
            <span class="crumb-sep">&rsaquo;</span>
            <span class="crumb-cur">@ngo.Name</span>
        </div>

        <h1 class="dash-title">NGO Dashboard</h1>
        <p class="dash-sub">Welcome back, @ngo.Name. Here's your overview.</p>

        <!-- ── Stat Cards ── -->
        <div class="stat-grid">
            <div class="stat-card">
                <div class="stat-ico green">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
                        <polyline points="17 6 23 6 23 12" />
                    </svg>
                </div>
                <div class="stat-value">PKR @FormatMoney(totalDonations)</div>
                <div class="stat-label">Total Donations</div>
                <div class="stat-trend up">+12% this month</div>
            </div>

            <div class="stat-card">
                <div class="stat-ico blue">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                    </svg>
                </div>
                <div class="stat-value">@activeCampaigns</div>
                <div class="stat-label">Active Campaigns</div>
                <div class="stat-trend">1 ending soon</div>
            </div>

            <div class="stat-card">
                <div class="stat-ico purple">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="2" />
                        <line x1="16" y1="2" x2="16" y2="6" />
                        <line x1="8" y1="2" x2="8" y2="6" />
                        <line x1="3" y1="10" x2="21" y2="10" />
                    </svg>
                </div>
                <div class="stat-value">@upcomingEvents</div>
                <div class="stat-label">Upcoming Events</div>
                <div class="stat-trend">@(nextEventLabel)</div>
            </div>

            <div class="stat-card">
                <div class="stat-ico amber">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                </div>
                <div class="stat-value">@pendingVolunteers</div>
                <div class="stat-label">Pending Volunteers</div>
                <div class="stat-trend">Needs review</div>
            </div>
        </div>

        <!-- ── Donation Trends ── -->
        <div class="panel">
            <div class="panel-head">
                <h3 class="panel-title">Donation Trends</h3>
                <span class="panel-tag">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-2px">
                        <line x1="18" y1="20" x2="18" y2="10" />
                        <line x1="12" y1="20" x2="12" y2="4" />
                        <line x1="6" y1="20" x2="6" y2="14" />
                    </svg>
                    Last 6 months
                </span>
            </div>

            <div class="chart">
                @{
                    decimal maxVal = trends.Count > 0 ? trends.Max(t => t.Total) : 0;
                    if (maxVal <= 0) maxVal = 1;
                }
                @foreach (var t in trends)
                {
                    var pct = (double)(t.Total / maxVal) * 100;
                    <div class="bar-col">
                        <div class="bar-wrap">
                            <div class="bar" style="height:@(pct.ToString("F1"))%" title="PKR @FormatMoney(t.Total)"></div>
                        </div>
                        <span class="bar-lbl">@t.Month</span>
                    </div>
                }
            </div>
        </div>

        <!-- ── Bottom row: Campaigns + Quick Actions ── -->
        <div class="bottom-grid">

            <!-- Active Campaigns -->
            <div class="panel">
                <div class="panel-head">
                    <h3 class="panel-title">Active Campaigns</h3>
                    <a class="manage-link" href="/ngo/campaigns">Manage &rarr;</a>
                </div>

                @if (campaigns.Count == 0)
                {
                    <p class="muted">No campaigns yet.</p>
                }
                else
                {
                    @foreach (var c in campaigns.Take(3))
                    {
                        var pct = c.GoalAmount > 0
                            ? (double)Math.Min(c.RaisedAmount * 100 / c.GoalAmount, 100) : 0;
                        var donors = c.Donations?.Count ?? 0;
                        <div class="camp-row">
                            <div class="camp-top">
                                <span class="camp-name">@c.Title</span>
                                <span class="camp-status @(c.Status == "Completed" ? "done" : "active")">
                                    @(c.Status == "Completed" ? "Completed" : "Active")
                                </span>
                            </div>
                            <div class="camp-meta">
                                <span>@donors donors</span>
                                <span>@pct.ToString("F0")% funded</span>
                            </div>
                            <div class="camp-track">
                                <div class="camp-fill" style="width:@(pct.ToString("F1"))%"></div>
                            </div>
                            <div class="camp-amounts">
                                <span class="raised">PKR @FormatMoney(c.RaisedAmount) raised</span>
                                <span class="goal">Goal: PKR @FormatMoney(c.GoalAmount)</span>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Quick Actions -->
            <div class="panel">
                <h3 class="panel-title qa-title">Quick Actions</h3>

                <button class="qa-btn" @onclick='() => Nav.NavigateTo("/ngo/campaigns")'>
                    <span class="qa-ico green">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                        </svg>
                    </span>
                    <span class="qa-text">Create New Campaign</span>
                    <span class="qa-arrow">&rsaquo;</span>
                </button>

                <button class="qa-btn" @onclick='() => Nav.NavigateTo("/ngo/events")'>
                    <span class="qa-ico blue">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <rect x="3" y="4" width="18" height="18" rx="2" />
                            <line x1="16" y1="2" x2="16" y2="6" />
                            <line x1="8" y1="2" x2="8" y2="6" />
                            <line x1="3" y1="10" x2="21" y2="10" />
                        </svg>
                    </span>
                    <span class="qa-text">Add Event</span>
                    <span class="qa-arrow">&rsaquo;</span>
                </button>

                <button class="qa-btn" @onclick='() => Nav.NavigateTo("/ngo/volunteers")'>
                    <span class="qa-ico amber">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                        </svg>
                    </span>
                    <span class="qa-text">Review Volunteers</span>
                    @if (pendingVolunteers > 0)
                    {
                        <span class="qa-badge">@pendingVolunteers</span>
                    }
                    <span class="qa-arrow">&rsaquo;</span>
                </button>

                <button class="qa-btn" @onclick='() => Nav.NavigateTo("/ngo/blogs")'>
                    <span class="qa-ico purple">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M12 20h9" />
                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />
                        </svg>
                    </span>
                    <span class="qa-text">Write Blog Post</span>
                    <span class="qa-arrow">&rsaquo;</span>
                </button>
            </div>
        </div>
    }
</div>

@code {
    private NGO? ngo;
    private List<Campaign> campaigns = new();
    private List<MonthlyDonation> trends = new();

    private decimal totalDonations;
    private int activeCampaigns;
    private int upcomingEvents;
    private int pendingVolunteers;
    private string nextEventLabel = "None scheduled";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId)) return;

        ngo = await NgoService.GetNGOByUserIdAsync(userId);
        if (ngo is null) return;

        campaigns = await CampaignService.GetCampaignsByNgoIdAsync(ngo.Id);
        totalDonations = await NgoService.GetTotalDonationsAsync(ngo.Id);
        activeCampaigns = await NgoService.GetActiveCampaignsCountAsync(ngo.Id);
        upcomingEvents = await NgoService.GetUpcomingEventsCountAsync(ngo.Id);
        pendingVolunteers = await NgoService.GetPendingVolunteersCountAsync(ngo.Id);
        trends = await NgoService.GetMonthlyDonationsAsync(ngo.Id);
    }

    private static string FormatMoney(decimal v)
    {
        if (v >= 1_000_000) return (v / 1_000_000m).ToString("0.#") + "M";
        if (v >= 1_000) return (v / 1_000m).ToString("0.#") + "K";
        return v.ToString("N0");
    }
}