@page "/ngo/blogs"
@layout NgoLayout
@using NekiConnect.Models
@using NekiConnect.Services
@inject NGOService NgoService
@inject BlogService BlogService
@inject AuthenticationStateProvider AuthProvider
@attribute [Authorize(Roles = "NGO")]

<Navbar/>

<div class="bl-page">

    <!-- Header -->
    <div class="bl-header">
        <div>
            <h1 class="bl-title">Blogs &amp; Updates</h1>
            <p class="bl-sub">Share impact stories, updates, and awareness posts.</p>
        </div>
        @if (showForm || editing is not null)
        {
            <button class="btn-new" @onclick="CancelForm">Cancel</button>
        }
        else
        {
            <button class="btn-new" @onclick="() => showForm = true">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="16" />
                    <line x1="8" y1="12" x2="16" y2="12" />
                </svg>
                New Post
            </button>
        }
    </div>

    <!-- Stat cards -->
    <div class="stat-row">
        <div class="stat-card">
            <div class="stat-num green">@publishedCount</div>
            <div class="stat-lbl">Published</div>
        </div>
        <div class="stat-card">
            <div class="stat-num amber">@draftCount</div>
            <div class="stat-lbl">Drafts</div>
        </div>
        <div class="stat-card">
            <div class="stat-num blue">@totalViews.ToString("N0")</div>
            <div class="stat-lbl">Total Views</div>
        </div>
    </div>

    <!-- Create / Edit form -->
    @if (showForm || editing is not null)
    {
        var model = editing ?? newPost;
        <div class="form-card">
            <h3 class="form-head">@(editing is null ? "Create New Post" : "Edit Post")</h3>
            <div class="form-grid">
                <div class="fcol full">
                    <label>Title</label>
                    <input @bind="model.Title" placeholder="e.g. Impact Report Q1 2026" />
                </div>
                <div class="fcol">
                    <label>Category</label>
                    <input @bind="model.Category" placeholder="e.g. Impact" />
                </div>
                <div class="fcol">
                    <label>Status</label>
                    <select @bind="model.Status">
                        <option value="Published">Published</option>
                        <option value="Draft">Draft</option>
                    </select>
                </div>
                <div class="fcol full">
                    <label>Image URL (optional)</label>
                    <input @bind="model.ImageUrl" placeholder="https://..." />
                </div>
                <div class="fcol full">
                    <label>Content</label>
                    <textarea rows="5" @bind="model.Content" placeholder="Write your post..."></textarea>
                </div>
            </div>
            <div class="form-actions">
                <button class="btn-ghost" @onclick="CancelForm">Cancel</button>
                <button class="btn-save" @onclick="SaveAsync">
                    @(editing is null ? "Publish Post" : "Save Changes")
                </button>
            </div>
        </div>
    }

    <!-- Posts -->
    @if (posts.Count == 0)
    {
        <div class="empty">No posts yet. Click "New Post" to write one.</div>
    }
    else
    {
        @foreach (var b in posts)
        {
            <div class="post-card">
                <div class="post-main">
                    <div class="post-ico">
                        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                        </svg>
                    </div>
                    <div class="post-info">
                        <div class="post-title-row">
                            <span class="post-title">@b.Title</span>
                            <span class="badge @(b.Status == "Published" ? "badge-pub" : "badge-draft")">@b.Status</span>
                        </div>
                        <div class="post-meta">
                            <span>@b.CreatedAt.ToString("MMM d, yyyy")</span>
                            @if (b.Status == "Published")
                            {
                                <span class="views">
                                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-1px">
                                        <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
                                        <polyline points="17 6 23 6 23 12" />
                                    </svg>
                                    @b.ViewCount.ToString("N0") views
                                </span>
                            }
                        </div>
                        @if (viewingId == b.Id)
                        {
                            <div class="post-body">@b.Content</div>
                        }
                    </div>
                </div>

                <div class="post-actions">
                    <button class="act view" @onclick="() => ToggleView(b.Id)">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                        View
                    </button>
                    <button class="act edit" @onclick="() => StartEdit(b)">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                        </svg>
                        Edit
                    </button>
                    <button class="act del" @onclick="() => DeleteAsync(b.Id)">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <polyline points="3 6 5 6 21 6" />
                            <path d="M19 6l-1 14H6L5 6" />
                            <path d="M10 11v6" />
                            <path d="M14 11v6" />
                        </svg>
                    </button>
                </div>
            </div>
        }
    }
</div>

@code {
    private NGO? ngo;
    private List<BlogPost> posts = new();
    private BlogPost newPost = new() { Status = "Published", Category = "General" };
    private BlogPost? editing;
    private bool showForm;
    private int viewingId;

    private int publishedCount => posts.Count(p => p.Status == "Published");
    private int draftCount => posts.Count(p => p.Status == "Draft");
    private int totalViews => posts.Sum(p => p.ViewCount);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId)) return;

        ngo = await NgoService.GetNGOByUserIdAsync(userId);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (ngo is null) return;
        posts = await BlogService.GetByNgoIdAsync(ngo.Id);
    }

    private async Task SaveAsync()
    {
        if (ngo is null) return;

        if (editing is not null)
        {
            await BlogService.UpdateAsync(editing);
        }
        else
        {
            if (string.IsNullOrWhiteSpace(newPost.Title)) return;
            newPost.NgoId = ngo.Id;
            newPost.CreatedAt = DateTime.UtcNow;
            await BlogService.CreateAsync(newPost);
            newPost = new() { Status = "Published", Category = "General" };
        }
        CancelForm();
        await LoadAsync();
    }

    private void StartEdit(BlogPost b)
    {
        editing = new BlogPost
        {
            Id = b.Id,
            Title = b.Title,
            Content = b.Content,
            ImageUrl = b.ImageUrl,
            Category = b.Category,
            Status = b.Status,
            ViewCount = b.ViewCount,
            CreatedAt = b.CreatedAt,
            NgoId = b.NgoId
        };
        showForm = false;
    }

    private async Task DeleteAsync(int id)
    {
        await BlogService.DeleteAsync(id);
        await LoadAsync();
    }

    private void ToggleView(int id) => viewingId = viewingId == id ? 0 : id;

    private void CancelForm()
    {
        showForm = false;
        editing = null;
        newPost = new() { Status = "Published", Category = "General" };
    }
}