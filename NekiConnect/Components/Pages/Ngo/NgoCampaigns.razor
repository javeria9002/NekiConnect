@page "/ngo/campaigns"
@layout NgoLayout
@using NekiConnect.Models
@inject INGOService NgoService
@inject ICampaignService CampaignService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@attribute [Authorize(Roles = "NGO")]

<Navbar/>

<div class="cp-page">

    <!-- Header -->
    <div class="cp-header">
        <div>
            <h1 class="cp-title">Campaigns</h1>
            <p class="cp-sub">Create and manage your fundraising campaigns.</p>
        </div>
        @if (showForm || editing is not null)
        {
            <button class="btn-new" @onclick="CancelForm">Cancel</button>
        }
        else
        {
            <button class="btn-new" @onclick="() => showForm = true">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="16" />
                    <line x1="8" y1="12" x2="16" y2="12" />
                </svg>
                New Campaign
            </button>
        }
    </div>

    <!-- Stat cards -->
    <div class="stat-row">
        <div class="stat-card">
            <div class="stat-num green">@activeCount</div>
            <div class="stat-lbl">Active</div>
        </div>
        <div class="stat-card">
            <div class="stat-num blue">@completedCount</div>
            <div class="stat-lbl">Completed</div>
        </div>
        <div class="stat-card">
            <div class="stat-num purple">PKR @FormatMoney(totalRaised)</div>
            <div class="stat-lbl">Total Raised</div>
        </div>
    </div>

    <!-- Create / Edit form -->
    @if (showForm || editing is not null)
    {
        var model = editing ?? newCampaign;
        <div class="form-card">
            <h3 class="form-head">@(editing is null ? "Create New Campaign" : "Edit Campaign")</h3>
            <div class="form-grid">
                <div class="fcol">
                    <label>Campaign Title</label>
                    <input @bind="model.Title" placeholder="e.g. Education for Every Child" />
                </div>
                <div class="fcol">
                    <label>Location</label>
                    <input @bind="model.Location" placeholder="e.g. Islamabad" />
                </div>
                <div class="fcol">
                    <label>Date</label>
                    <input type="date" @bind="model.CampaignDate" />
                </div>
                <div class="fcol">
                    <label>Total Spots</label>
                    <input type="number" @bind="model.SeatsAvailable" placeholder="50" />
                </div>
                <div class="fcol">
                    <label>Goal Amount (PKR)</label>
                    <input type="number" @bind="model.GoalAmount" placeholder="1200000" />
                </div>
                <div class="fcol">
                    <label>Image URL (optional)</label>
                    <input @bind="model.ImageUrl" placeholder="https://..." />
                </div>
                <div class="fcol full">
                    <label>Description</label>
                    <textarea rows="3" @bind="model.Description" placeholder="Describe the campaign..."></textarea>
                </div>
            </div>
            <div class="form-actions">
                <button class="btn-ghost" @onclick="CancelForm">Cancel</button>
                <button class="btn-save" @onclick="SaveAsync">
                    @(editing is null ? "Create Campaign" : "Save Changes")
                </button>
            </div>
        </div>
    }

    <!-- Search -->
    <div class="search-wrap">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input class="search-inp" placeholder="Search campaigns..." @bind="search" @bind:event="oninput" />
    </div>

    <!-- Campaign rows -->
    @if (Filtered.Count == 0)
    {
        <div class="empty">No campaigns found.</div>
    }
    else
    {
        @foreach (var c in Filtered)
        {
            var pct = c.GoalAmount > 0 ? (double)Math.Min(c.RaisedAmount * 100 / c.GoalAmount, 100) : 0;
            var donors = c.Donations?.Count ?? 0;
            var daysLeft = (c.CampaignDate.Date - DateTime.Today).Days;
            var isActive = c.Status == "Upcoming";

            <div class="camp-card">
                <div class="camp-row">
                    <div class="camp-left">
                        <div class="camp-title-row">
                            <span class="camp-title">@c.Title</span>
                            <span class="badge @(isActive ? "badge-active" : "badge-done")">
                                @(isActive ? "Active" : "Completed")
                            </span>
                            @if (isActive && daysLeft >= 0)
                            {
                                <span class="badge badge-days">@daysLeft d left</span>
                            }
                        </div>

                        <div class="camp-stats">
                            <div class="cstat">
                                <span class="cstat-lbl">Raised</span>
                                <span class="cstat-val green">PKR @FormatMoney(c.RaisedAmount)</span>
                            </div>
                            <div class="cstat">
                                <span class="cstat-lbl">Goal</span>
                                <span class="cstat-val">PKR @FormatMoney(c.GoalAmount)</span>
                            </div>
                            <div class="cstat">
                                <span class="cstat-lbl">Donors</span>
                                <span class="cstat-val">@donors</span>
                            </div>
                        </div>

                        <div class="prog-label">
                            <span>Progress</span>
                            <span>@pct.ToString("F0")%</span>
                        </div>
                        <div class="prog-track">
                            <div class="prog-fill" style="width:@(pct.ToString("F1"))%"></div>
                        </div>
                    </div>

                    <div class="camp-actions">
                        <button class="act view" @onclick="() => ViewCampaign(c.Id)">
                            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                            View
                        </button>
                        <button class="act edit" @onclick="() => StartEdit(c)">
                            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                            </svg>
                            Edit
                        </button>
                        <button class="act del" @onclick="() => DeleteAsync(c.Id)">
                            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <polyline points="3 6 5 6 21 6" />
                                <path d="M19 6l-1 14H6L5 6" />
                                <path d="M10 11v6" />
                                <path d="M14 11v6" />
                            </svg>
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private NGO? ngo;
    private List<Campaign> campaigns = new();
    private Campaign newCampaign = new() { CampaignDate = DateTime.Today };
    private Campaign? editing;
    private bool showForm;
    private string search = "";

    private int activeCount => campaigns.Count(c => c.Status == "Upcoming");
    private int completedCount => campaigns.Count(c => c.Status == "Completed");
    private decimal totalRaised => campaigns.Sum(c => c.RaisedAmount);

    private List<Campaign> Filtered =>
        string.IsNullOrWhiteSpace(search)
            ? campaigns
            : campaigns.Where(c => c.Title.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId)) return;

        ngo = await NgoService.GetNGOByUserIdAsync(userId);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (ngo is null) return;
        campaigns = await CampaignService.GetCampaignsByNgoIdAsync(ngo.Id);
    }

    private async Task SaveAsync()
    {
        if (ngo is null) return;

        if (editing is not null)
        {
            await CampaignService.UpdateCampaignAsync(editing);
        }
        else
        {
            if (string.IsNullOrWhiteSpace(newCampaign.Title)) return;
            newCampaign.NgoId = ngo.Id;
            await CampaignService.CreateCampaignAsync(newCampaign);
            newCampaign = new() { CampaignDate = DateTime.Today };
        }
        CancelForm();
        await LoadAsync();
    }

    private void StartEdit(Campaign c)
    {
        editing = new Campaign
        {
            Id = c.Id,
            Title = c.Title,
            Location = c.Location,
            CampaignDate = c.CampaignDate,
            SeatsAvailable = c.SeatsAvailable,
            GoalAmount = c.GoalAmount,
            RaisedAmount = c.RaisedAmount,
            Description = c.Description,
            ImageUrl = c.ImageUrl,
            Status = c.Status,
            NgoId = c.NgoId
        };
        showForm = false;
    }

    private async Task DeleteAsync(int id)
    {
        await CampaignService.DeleteCampaignAsync(id);
        await LoadAsync();
    }

    private void CancelForm()
    {
        showForm = false;
        editing = null;
        newCampaign = new() { CampaignDate = DateTime.Today };
    }

    private void ViewCampaign(int id) => Nav.NavigateTo($"/campaign/{id}");

    private static string FormatMoney(decimal v)
    {
        if (v >= 1_000_000) return (v / 1_000_000m).ToString("0.#") + "M";
        if (v >= 1_000) return (v / 1_000m).ToString("0.#") + "K";
        return v.ToString("N0");
    }
}