@page "/ngo/beneficiaries"
@layout NgoLayout
@using NekiConnect.Models
@inject INGOService NgoService
@inject IBeneficiaryService BeneficiaryService
@inject AuthenticationStateProvider AuthProvider
@attribute [Authorize(Roles = "NGO")]


<div class="bf-page">

    <!-- Header -->
    <div class="bf-header">
        <div>
            <h1 class="bf-title">Beneficiary Records</h1>
            <p class="bf-sub">Track and manage all individuals and groups receiving aid.</p>
        </div>
        @if (showForm || editing is not null)
        {
            <button class="btn-add" @onclick="CancelForm">Cancel</button>
        }
        else
        {
            <button class="btn-add" @onclick="() => showForm = true">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="16" />
                    <line x1="8" y1="12" x2="16" y2="12" />
                </svg>
                Add Record
            </button>
        }
    </div>

    <!-- Stat cards -->
    <div class="stat-row">
        <div class="stat-card">
            <div class="stat-num green">@activeCount</div>
            <div class="stat-lbl">Active</div>
        </div>
        <div class="stat-card">
            <div class="stat-num blue">@completedCount</div>
            <div class="stat-lbl">Completed</div>
        </div>
        <div class="stat-card">
            <div class="stat-num dark">@records.Count</div>
            <div class="stat-lbl">Total Records</div>
        </div>
    </div>

    <!-- Form -->
    @if (showForm || editing is not null)
    {
        var model = editing ?? newRecord;
        <div class="form-card">
            <h3 class="form-head">@(editing is null ? "Add New Record" : "Edit Record")</h3>
            <div class="form-grid">
                <div class="fcol">
                    <label>Beneficiary Name</label>
                    <input @bind="model.Name" placeholder="e.g. Household #1248" />
                </div>
                <div class="fcol">
                    <label>Province</label>
                    <select @bind="model.Province">
                        <option value="Punjab">Punjab</option>
                        <option value="Sindh">Sindh</option>
                        <option value="KPK">KPK</option>
                        <option value="Balochistan">Balochistan</option>
                        <option value="Gilgit-Baltistan">Gilgit-Baltistan</option>
                        <option value="AJK">AJK</option>
                        <option value="Islamabad">Islamabad</option>
                    </select>
                </div>
                <div class="fcol">
                    <label>Aid Type</label>
                    <select @bind="model.AidType">
                        <option value="Food Aid">Food Aid</option>
                        <option value="Education">Education</option>
                        <option value="Healthcare">Healthcare</option>
                        <option value="Emergency Relief">Emergency Relief</option>
                        <option value="Children">Children</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="fcol">
                    <label>Status</label>
                    <select @bind="model.Status">
                        <option value="Active">Active</option>
                        <option value="Completed">Completed</option>
                    </select>
                </div>
                <div class="fcol full">
                    <label>Notes (optional)</label>
                    <textarea rows="3" @bind="model.Notes" placeholder="Additional details..."></textarea>
                </div>
            </div>
            <div class="form-actions">
                <button class="btn-ghost" @onclick="CancelForm">Cancel</button>
                <button class="btn-save" @onclick="SaveAsync">
                    @(editing is null ? "Add Record" : "Save Changes")
                </button>
            </div>
        </div>
    }

    <!-- Search -->
    <div class="search-wrap">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input class="search-inp" placeholder="Search records..." @bind="search" @bind:event="oninput" />
    </div>

    <!-- Table -->
    <div class="table-card">
        @if (Filtered.Count == 0)
        {
            <div class="empty">No records found.</div>
        }
        else
        {
            <table class="bf-table">
                <thead>
                    <tr>
                        <th>BENEFICIARY</th>
                        <th>PROVINCE</th>
                        <th>AID TYPE</th>
                        <th>LAST UPDATED</th>
                        <th>STATUS</th>
                        <th class="ta-right">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Filtered)
                    {
                        <tr>
                            <td>
                                <div class="bf-name">
                                    <span class="bf-ico">
                                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                            <circle cx="9" cy="7" r="4" />
                                            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                        </svg>
                                    </span>
                                    @b.Name
                                </div>
                            </td>
                            <td>
                                <span class="bf-province">
                                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-2px">
                                        <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 1 1 18 0z" />
                                        <circle cx="12" cy="10" r="3" />
                                    </svg>
                                    @b.Province
                                </span>
                            </td>
                            <td><span class="aid-badge">@b.AidType</span></td>
                            <td class="bf-date">@b.UpdatedAt.ToString("MMM d, yyyy")</td>
                            <td>
                                <span class="status-badge @(b.Status == "Active" ? "st-active" : "st-done")">@b.Status</span>
                            </td>
                            <td class="ta-right">
                                <div class="row-actions">
                                    <button class="act view" @onclick="() => ToggleView(b.Id)">
                                        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                            <circle cx="12" cy="12" r="3" />
                                        </svg>
                                        View
                                    </button>
                                    <button class="act edit" @onclick="() => StartEdit(b)">
                                        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                        </svg>
                                        Edit
                                    </button>
                                    <button class="act del" @onclick="() => DeleteAsync(b.Id)">
                                        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <polyline points="3 6 5 6 21 6" />
                                            <path d="M19 6l-1 14H6L5 6" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        @if (viewingId == b.Id && !string.IsNullOrWhiteSpace(b.Notes))
                        {
                            <tr class="detail-row">
                                <td colspan="6">
                                    <div class="detail-box"><strong>Notes:</strong> @b.Notes</div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private NGO? ngo;
    private List<Beneficiary> records = new();
    private Beneficiary newRecord = new() { Province = "Punjab", AidType = "Food Aid", Status = "Active" };
    private Beneficiary? editing;
    private bool showForm;
    private string search = "";
    private int viewingId;

    private int activeCount => records.Count(r => r.Status == "Active");
    private int completedCount => records.Count(r => r.Status == "Completed");

    private List<Beneficiary> Filtered =>
        string.IsNullOrWhiteSpace(search)
            ? records
            : records.Where(r => r.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                              || r.Province.Contains(search, StringComparison.OrdinalIgnoreCase)
                              || r.AidType.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId)) return;

        ngo = await NgoService.GetNGOByUserIdAsync(userId);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (ngo is null) return;
        records = await BeneficiaryService.GetByNgoIdAsync(ngo.Id);
    }

    private async Task SaveAsync()
    {
        if (ngo is null) return;

        if (editing is not null)
        {
            await BeneficiaryService.UpdateAsync(editing);
        }
        else
        {
            if (string.IsNullOrWhiteSpace(newRecord.Name)) return;
            newRecord.NgoId = ngo.Id;
            await BeneficiaryService.CreateAsync(newRecord);
            newRecord = new() { Province = "Punjab", AidType = "Food Aid", Status = "Active" };
        }
        CancelForm();
        await LoadAsync();
    }

    private void StartEdit(Beneficiary b)
    {
        editing = new Beneficiary
        {
            Id = b.Id,
            Name = b.Name,
            Province = b.Province,
            AidType = b.AidType,
            Status = b.Status,
            Notes = b.Notes,
            CreatedAt = b.CreatedAt,
            NgoId = b.NgoId
        };
        showForm = false;
    }

    private async Task DeleteAsync(int id)
    {
        await BeneficiaryService.DeleteAsync(id);
        await LoadAsync();
    }

    private void ToggleView(int id) => viewingId = viewingId == id ? 0 : id;

    private void CancelForm()
    {
        showForm = false;
        editing = null;
        newRecord = new() { Province = "Punjab", AidType = "Food Aid", Status = "Active" };
    }
}