@inherits LayoutComponentBase
@using NekiConnect.Models
@using NekiConnect.Services
@inject NGOService NgoService
@inject AuthenticationStateProvider AuthProvider

<div class="ngo-shell">

    <!-- ── Sidebar ── -->
    <aside class="ngo-sidebar">
        <div class="side-head">
            <div class="side-avatar">
                @(string.IsNullOrEmpty(ngoName) ? "N" : ngoName.Substring(0, 1))
            </div>
            <div class="side-info">
                <div class="side-name">
                    @(string.IsNullOrEmpty(ngoName) ? "NGO Portal" : ngoName)
                </div>
                <div class="side-verified">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M9 12l2 2 4-4" />
                        <circle cx="12" cy="12" r="10" />
                    </svg>
                    Verified NGO
                </div>
            </div>
        </div>

        <nav class="side-nav">

            <NavLink class="nav-link" href="/ngo/dashboard" Match="NavLinkMatch.All">
                Dashboard
            </NavLink>

            <NavLink class="nav-link" href="/ngo/campaigns">
                Campaigns
            </NavLink>

            <NavLink class="nav-link" href="/ngo/events">
                Events
            </NavLink>

            <NavLink class="nav-link" href="/ngo/volunteers">
                Volunteers
                @if (pendingVolunteers > 0)
                {
                    <span class="nav-badge">@pendingVolunteers</span>
                }
            </NavLink>

            <NavLink class="nav-link" href="/ngo/blogs">
                Blogs
            </NavLink>

            <!-- kept from feature branch -->
            <NavLink class="nav-link" href="/ngo/branches">
                Branches
            </NavLink>

            <NavLink class="nav-link" href="/ngo/beneficiaries">
                Beneficiaries
            </NavLink>

            <NavLink class="nav-link" href="/ngo/profile">
                Profile
            </NavLink>

        </nav>

        <a class="side-logout" href="/logout">
            Logout
        </a>
    </aside>

    <!-- ── Main content ── -->
    <main class="ngo-main">
        @Body
    </main>
</div>

@code {
    private string ngoName = "";
    private int pendingVolunteers;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userId))
            return;

        var ngo = await NgoService.GetNGOByUserIdAsync(userId);
        if (ngo is null)
            return;

        ngoName = ngo.Name;
        pendingVolunteers = await NgoService.GetPendingVolunteersCountAsync(ngo.Id);
    }
}