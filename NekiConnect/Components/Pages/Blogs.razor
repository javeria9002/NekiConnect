@page "/blogs"
@rendermode InteractiveServer
@inject BlogService BlogService
@inject NavigationManager Navigation

<PageTitle>Blogs — NekiConnect</PageTitle>

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #f9fafb; color: #111827; }

    .breadcrumb { padding:14px 2rem; font-size:13px; color:#6b7280; border-bottom:1px solid #f3f4f6; background:#fff; }
    .breadcrumb a { color:#16a34a; text-decoration:none; cursor:pointer; }
    .breadcrumb span { margin:0 6px; color:#d1d5db; }

    .page { max-width:900px; margin:0 auto; padding:32px 20px 60px; }
    .page-title { font-size:26px; font-weight:700; color:#111827; margin-bottom:6px; }
    .page-sub { font-size:14px; color:#6b7280; margin-bottom:28px; }

    .featured { background:#16a34a; border-radius:14px; padding:32px 36px; margin-bottom:28px; color:white; position:relative; overflow:hidden; cursor:pointer; transition:opacity .15s; }
    .featured:hover { opacity:.95; }
    .featured::before { content:''; position:absolute; right:-40px; top:-40px; width:200px; height:200px; background:rgba(255,255,255,0.06); border-radius:50%; }
    .featured-badge { display:inline-flex; align-items:center; gap:6px; background:rgba(255,255,255,0.18); border-radius:20px; padding:3px 12px; font-size:11.5px; font-weight:600; margin-bottom:14px; }
    .featured-title { font-size:22px; font-weight:700; margin-bottom:10px; line-height:1.3; }
    .featured-excerpt { font-size:13.5px; opacity:.88; line-height:1.6; margin-bottom:18px; max-width:600px; }
    .featured-meta { display:flex; align-items:center; gap:16px; font-size:12.5px; opacity:.82; margin-bottom:18px; }
    .avatar-sm { width:26px; height:26px; border-radius:50%; background:rgba(255,255,255,0.3); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; flex-shrink:0; }
    .btn-read { display:inline-flex; align-items:center; gap:6px; background:white; color:#16a34a; border:none; padding:9px 20px; border-radius:8px; font-size:13.5px; font-weight:600; cursor:pointer; font-family:'Segoe UI',sans-serif; }
    .btn-read:hover { background:#f0fdf4; }

    .toolbar { display:flex; align-items:center; gap:12px; margin-bottom:24px; flex-wrap:wrap; }
    .search-wrap { position:relative; flex:1; min-width:200px; }
    .search-icon { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#9ca3af; pointer-events:none; }
    .search-input { width:100%; padding:9px 12px 9px 38px; border:1.5px solid #e5e7eb; border-radius:8px; font-size:13.5px; color:#111; font-family:'Segoe UI',sans-serif; outline:none; background:white; }
    .search-input:focus { border-color:#16a34a; }
    .filter-tabs { display:flex; gap:6px; flex-wrap:wrap; }
    .filter-btn { padding:7px 16px; border-radius:20px; font-size:13px; font-weight:500; border:1.5px solid #e5e7eb; background:white; color:#374151; cursor:pointer; font-family:'Segoe UI',sans-serif; transition:all .15s; }
    .filter-btn:hover { border-color:#16a34a; color:#16a34a; }
    .filter-btn.active { background:#16a34a; color:white; border-color:#16a34a; }

    .blog-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
    @@media (max-width:700px) { .blog-grid { grid-template-columns:1fr; } }
    @@media (max-width:900px) and (min-width:700px) { .blog-grid { grid-template-columns:repeat(2,1fr); } }

    .blog-card { background:white; border:1px solid #e5e7eb; border-radius:12px; padding:18px; display:flex; flex-direction:column; gap:10px; cursor:pointer; transition:box-shadow .15s,transform .15s; }
    .blog-card:hover { box-shadow:0 4px 20px rgba(0,0,0,0.08); transform:translateY(-2px); }

    .card-tag { display:inline-block; font-size:11px; font-weight:600; padding:2px 10px; border-radius:20px; width:fit-content; }
    .tag-Impact    { background:#dcfce7; color:#15803d; }
    .tag-Guide     { background:#dbeafe; color:#1d4ed8; }
    .tag-Story     { background:#fce7f3; color:#be185d; }
    .tag-Report    { background:#fef3c7; color:#92400e; }
    .tag-Awareness { background:#ede9fe; color:#6d28d9; }

    .card-title { font-size:14.5px; font-weight:700; color:#111827; line-height:1.4; }
    .card-excerpt { font-size:12.5px; color:#6b7280; line-height:1.5; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
    .card-meta { display:flex; align-items:center; gap:8px; font-size:11.5px; color:#9ca3af; margin-top:auto; }
    .avatar-xs { width:22px; height:22px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:10px; font-weight:700; color:white; flex-shrink:0; }
    .card-author { font-weight:600; color:#374151; font-size:12px; }
    .dot-sep { width:3px; height:3px; border-radius:50%; background:#d1d5db; }

    .empty { text-align:center; padding:60px 20px; color:#9ca3af; }
    .empty-icon { font-size:48px; margin-bottom:16px; }
    .empty h3 { font-size:18px; color:#374151; margin-bottom:8px; }
    .loading { text-align:center; padding:60px; color:#9ca3af; font-size:14px; }
</style>

<Navbar />

<div class="breadcrumb">
    <a @onclick='() => Navigation.NavigateTo("/")'>Home</a>
    <span>›</span> Blogs
</div>

<div class="page">
    <h1 class="page-title">NekiConnect Blog</h1>
    <p class="page-sub">Impact stories, guides, and updates from NGOs and donors across Pakistan.</p>

    @if (isLoading)
    {
        <div class="loading">Loading blog posts...</div>
    }
    else
    {
        @if (featuredPost != null)
        {
            <div class="featured" @onclick="() => GoToBlog(featuredPost.Id)">
                <div class="featured-badge">⭐ Featured · @GetTag(featuredPost)</div>
                <div class="featured-title">@featuredPost.Title</div>
                <div class="featured-excerpt">
                    @(featuredPost.Content.Length > 180
                        ? featuredPost.Content[..180] + "..."
                        : featuredPost.Content)
                </div>
                <div class="featured-meta">
                    <div class="avatar-sm">@GetInitial(featuredPost)</div>
                    <span>@GetNgoName(featuredPost)</span>
                    <span>·</span>
                    <span>@featuredPost.CreatedAt.ToString("MMM dd, yyyy")</span>
                    <span>·</span>
                    <span>@GetReadTime(featuredPost.Content) min read</span>
                </div>
                <button class="btn-read"
                        @onclick:stopPropagation
                        @onclick="() => GoToBlog(featuredPost.Id)">
                    Read Article →
                </button>
            </div>
        }

        <div class="toolbar">
            <div class="search-wrap">
                <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
                </svg>
                <input class="search-input"
                       placeholder="Search blog posts..."
                       @bind="searchQuery"
                       @bind:event="oninput" />
            </div>
            <div class="filter-tabs">
                @foreach (var tag in allTags)
                {
                    var t = tag;
                    <button class="filter-btn @(activeFilter == t ? "active" : "")"
                            @onclick="() => activeFilter = t">@t</button>
                }
            </div>
        </div>

        @if (FilteredBlogs.Count == 0)
        {
            <div class="empty">
                <div class="empty-icon">📝</div>
                <h3>No posts found</h3>
                <p>Try a different search term or category filter.</p>
            </div>
        }
        else
        {
            <div class="blog-grid">
                @foreach (var blog in FilteredBlogs)
                {
                    var b = blog;
                    <div class="blog-card" @onclick="() => GoToBlog(b.Id)">
                        <span class="card-tag @GetTagClass(b)">@GetTag(b)</span>
                        <div class="card-title">@b.Title</div>
                        <div class="card-excerpt">
                            @(b.Content.Length > 120 ? b.Content[..120] + "..." : b.Content)
                        </div>
                        <div class="card-meta">
                            <div class="avatar-xs" style="background:@GetAvatarColor(b)">@GetInitial(b)</div>
                            <span class="card-author">@GetNgoName(b)</span>
                            <span class="dot-sep"></span>
                            <span>@GetReadTime(b.Content) min</span>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private List<BlogPost> allBlogs     = new();
    private bool           isLoading    = true;
    private string         searchQuery  = string.Empty;
    private string         activeFilter = "All";
    private string[]       allTags      = { "All", "Impact", "Guide", "Story", "Report", "Awareness" };

    private BlogPost? featuredPost => allBlogs.FirstOrDefault();

    private List<BlogPost> FilteredBlogs
    {
        get
        {
            var list = allBlogs.Skip(1).ToList();
            if (activeFilter != "All")
                list = list.Where(b => string.Equals(
                    string.IsNullOrEmpty(b.Category) ? "Impact" : b.Category,
                    activeFilter, StringComparison.OrdinalIgnoreCase)).ToList();
            if (!string.IsNullOrWhiteSpace(searchQuery))
                list = list.Where(b =>
                    b.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    b.Content.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
            return list;
        }
    }

    private void GoToBlog(int id) => Navigation.NavigateTo($"/blog/{id}");

    protected override async Task OnInitializedAsync()
    {
        allBlogs  = await BlogService.GetAllBlogsAsync();
        isLoading = false;
    }

    private string GetNgoName(BlogPost b)  => b.NGO?.Name ?? "NekiConnect";
    private string GetInitial(BlogPost b)  => b.NGO?.Name?.FirstOrDefault().ToString().ToUpper() ?? "N";
    private int    GetReadTime(string c)   => Math.Max(1, c.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length / 200);
    private string GetTag(BlogPost b)      => string.IsNullOrEmpty(b.Category) ? "Impact" : b.Category;
    private string GetTagClass(BlogPost b) => GetTag(b) switch
    {
        "Guide"     => "tag-Guide",
        "Story"     => "tag-Story",
        "Report"    => "tag-Report",
        "Awareness" => "tag-Awareness",
        _           => "tag-Impact"
    };
    private string GetAvatarColor(BlogPost b)
    {
        var colors = new[] { "#16a34a", "#2563eb", "#9333ea", "#ea580c", "#0891b2", "#dc2626" };
        return colors[Math.Abs((b.NgoId - 1) % colors.Length)];
    }
}