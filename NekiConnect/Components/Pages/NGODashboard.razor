@page "/ngo/dashboard"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject NGOService NgoService
@inject FundraisingService FundraisingService
@inject CampaignService CampaignService
@inject DonationService DonationService
@inject VolunteerService VolunteerService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>NGO Dashboard — NekiConnect</PageTitle>

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #f9fafb; }

    .layout { display: flex; min-height: 100vh; }

    /* ── Sidebar ── */
    .sidebar { width: 200px; background: #fff; border-right: 1px solid #e5e7eb; display: flex; flex-direction: column; position: fixed; top: 0; left: 0; height: 100vh; z-index: 50; }
    .sidebar-top { padding: 20px 16px 16px; border-bottom: 1px solid #f3f4f6; }
    .ngo-avatar { width: 36px; height: 36px; background: #16a34a; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 15px; font-weight: 700; color: white; flex-shrink: 0; }
    .ngo-name { font-size: 13px; font-weight: 600; color: #111; margin-top: 8px; }
    .ngo-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; color: #16a34a; font-weight: 500; margin-top: 3px; }

    .sidebar-nav { flex: 1; padding: 12px 8px; display: flex; flex-direction: column; gap: 2px; }
    .nav-item { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 8px; font-size: 13px; font-weight: 500; color: #374151; cursor: pointer; text-decoration: none; transition: all .15s; }
    .nav-item:hover { background: #f0fdf4; color: #16a34a; }
    .nav-item.active { background: #16a34a; color: white; }
    .nav-item svg { flex-shrink: 0; }
    .badge { background: #fef9c3; color: #854d0e; font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 10px; margin-left: auto; }
    .nav-item.active .badge { background: rgba(255,255,255,0.25); color: white; }

    .sidebar-bottom { padding: 12px 8px; border-top: 1px solid #f3f4f6; }
    .logout-btn { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 8px; font-size: 13px; font-weight: 500; color: #6b7280; cursor: pointer; background: none; border: none; font-family: inherit; width: 100%; transition: all .15s; }
    .logout-btn:hover { background: #fef2f2; color: #dc2626; }

    /* ── Main ── */
    .main { margin-left: 200px; flex: 1; display: flex; flex-direction: column; }

    /* Top bar */
    .topbar { background: #fff; border-bottom: 1px solid #e5e7eb; padding: 0 28px; height: 52px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 40; }
    .breadcrumb { font-size: 12.5px; color: #6b7280; display: flex; align-items: center; gap: 6px; }
    .breadcrumb span { color: #d1d5db; }
    .breadcrumb a { color: #374151; text-decoration: none; cursor: pointer; }
    .topbar-right { display: flex; align-items: center; gap: 10px; }
    .topbar-ngo { font-size: 13px; font-weight: 600; color: #111; }

    /* Content */
    .content { padding: 28px; }
    .page-title { font-size: 22px; font-weight: 700; color: #111827; margin-bottom: 4px; }
    .page-sub { font-size: 13px; color: #6b7280; margin-bottom: 24px; }

    /* Stat cards */
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
    .stat-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 18px 20px; }
    .stat-icon { width: 36px; height: 36px; border-radius: 9px; display: flex; align-items: center; justify-content: center; margin-bottom: 12px; }
    .stat-icon.green  { background: #dcfce7; }
    .stat-icon.blue   { background: #dbeafe; }
    .stat-icon.purple { background: #ede9fe; }
    .stat-icon.amber  { background: #fef3c7; }
    .stat-value { font-size: 22px; font-weight: 700; color: #111827; margin-bottom: 3px; }
    .stat-label { font-size: 12px; color: #6b7280; margin-bottom: 5px; }
    .stat-sub { font-size: 11.5px; }
    .stat-sub.green  { color: #16a34a; }
    .stat-sub.amber  { color: #d97706; }
    .stat-sub.blue   { color: #2563eb; }

    /* Chart area */
    .chart-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px 24px; margin-bottom: 24px; }
    .card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .card-title { font-size: 15px; font-weight: 600; color: #111827; }
    .card-meta { font-size: 12px; color: #9ca3af; display: flex; align-items: center; gap: 5px; }
    .chart-bars { display: flex; align-items: flex-end; gap: 12px; height: 140px; padding-top: 10px; }
    .bar-col { display: flex; flex-direction: column; align-items: center; gap: 6px; flex: 1; }
    .bar { width: 100%; background: #16a34a; border-radius: 4px 4px 0 0; transition: opacity .2s; min-height: 4px; }
    .bar:hover { opacity: .8; }
    .bar-label { font-size: 11px; color: #9ca3af; }
    .chart-y { display: flex; flex-direction: column; justify-content: space-between; height: 140px; padding-right: 8px; }
    .y-label { font-size: 10.5px; color: #9ca3af; }
    .chart-wrap { display: flex; }

    /* Bottom grid */
    .bottom-grid { display: grid; grid-template-columns: 1fr 280px; gap: 16px; }
    .campaigns-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px 24px; }
    .manage-link { font-size: 13px; color: #16a34a; font-weight: 500; text-decoration: none; cursor: pointer; display: flex; align-items: center; gap: 4px; }
    .manage-link:hover { text-decoration: underline; }
    .campaign-row { padding: 14px 0; border-bottom: 1px solid #f3f4f6; }
    .campaign-row:last-child { border-bottom: none; }
    .campaign-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
    .campaign-name { font-size: 13.5px; font-weight: 600; color: #111827; }
    .status-badge { font-size: 11px; font-weight: 600; padding: 2px 10px; border-radius: 20px; }
    .status-active    { background: #dcfce7; color: #15803d; }
    .status-completed { background: #f3f4f6; color: #6b7280; }
    .status-upcoming  { background: #dbeafe; color: #1d4ed8; }
    .campaign-donors { font-size: 12px; color: #9ca3af; margin-bottom: 7px; }
    .progress-bar { height: 5px; background: #f3f4f6; border-radius: 10px; overflow: hidden; margin-bottom: 5px; }
    .progress-fill { height: 100%; background: #16a34a; border-radius: 10px; }
    .campaign-amounts { display: flex; justify-content: space-between; font-size: 11.5px; color: #6b7280; }
    .campaign-amounts .raised { color: #16a34a; font-weight: 600; }

    /* Quick actions */
    .actions-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px 20px; }
    .action-item { display: flex; align-items: center; justify-content: space-between; padding: 11px 0; border-bottom: 1px solid #f3f4f6; cursor: pointer; }
    .action-item:last-child { border-bottom: none; }
    .action-item:hover .action-label { color: #16a34a; }
    .action-left { display: flex; align-items: center; gap: 10px; }
    .action-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .action-label { font-size: 13px; font-weight: 500; color: #374151; }
    .action-arrow { color: #9ca3af; font-size: 16px; }
    .action-badge { background: #fef9c3; color: #854d0e; font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 10px; }

    .loading { text-align: center; padding: 60px; color: #9ca3af; font-size: 14px; }
    .access-denied { text-align: center; padding: 80px 20px; }
    .access-denied h2 { font-size: 20px; color: #374151; margin-bottom: 8px; }
    .access-denied p { font-size: 14px; color: #9ca3af; margin-bottom: 20px; }
    .btn-go { background: #16a34a; color: white; border: none; padding: 10px 24px; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; font-family: inherit; }
</style>

<Navbar/>
@if (isLoading)
{
    <div class="loading">Loading your dashboard...</div>
}
else if (currentNgo == null)
{
    <div class="access-denied">
        <h2>Access Denied</h2>
        <p>You must be logged in as an approved NGO to view this dashboard.</p>
        <button class="btn-go" @onclick='() => Navigation.NavigateTo("/login")'>Go to Login</button>
    </div>
}
else
{
    <div class="layout">

        <!-- ── Sidebar ── -->
        <aside class="sidebar">
            <div class="sidebar-top">
                <div class="ngo-avatar">@GetInitial()</div>
                <div class="ngo-name">@currentNgo.Name</div>
                <div class="ngo-badge">
                    <svg width="12" height="12" fill="#16a34a" viewBox="0 0 24 24">
                        <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0 1 12 2.944a11.955 11.955 0 0 1-8.618 3.04A12.02 12.02 0 0 0 3 9c0 5.591 3.824 10.29 9 11.622C17.176 19.29 21 14.591 21 9c0-1.067-.143-2.1-.382-3.016z"/>
                    </svg>
                    Verified NGO
                </div>
            </div>

            <nav class="sidebar-nav">
                <a class="nav-item active" href="/ngo/dashboard">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                    Dashboard
                </a>
                <a class="nav-item" href="/ngo/fundraising">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                    Fundraising
                </a>
                <a class="nav-item" href="/ngo/campaigns">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    Campaigns
                </a>
                <a class="nav-item" href="/ngo/volunteers">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Volunteers
                    @if (pendingVolunteers > 0)
                    {
                        <span class="badge">@pendingVolunteers</span>
                    }
                </a>
                <a class="nav-item" href="/ngo/blogs">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    Blogs
                </a>
                <a class="nav-item" href="/ngo/beneficiaries">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                    Beneficiaries
                </a>
            </nav>

            <div class="sidebar-bottom">
                <button class="logout-btn" @onclick="HandleLogout">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    Logout
                </button>
            </div>
        </aside>

        <!-- ── Main content ── -->
        <div class="main">

            <!-- Top bar -->
            <div class="topbar">
                <div class="breadcrumb">
                    <a @onclick='() => Navigation.NavigateTo("/")'>NGO Portal</a>
                    <span>›</span>
                    @currentNgo.Name
                </div>
                <div class="topbar-right">
                    <span class="topbar-ngo">@currentNgo.Name</span>
                </div>
            </div>

            <!-- Content -->
            <div class="content">
                <h1 class="page-title">NGO Dashboard</h1>
                <p class="page-sub">Welcome back, @currentNgo.Name. Here's your overview.</p>

                <!-- Stat cards -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon green">
                            <svg width="18" height="18" fill="none" stroke="#16a34a" stroke-width="2" viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                        </div>
                        <div class="stat-value">PKR @FormatAmount(totalDonations)</div>
                        <div class="stat-label">Total Donations</div>
                        <div class="stat-sub green">+12% this month</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon blue">
                            <svg width="18" height="18" fill="none" stroke="#2563eb" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                        </div>
                        <div class="stat-value">@activeCampaigns</div>
                        <div class="stat-label">Active Campaigns</div>
                        <div class="stat-sub amber">@endingSoon ending soon</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon purple">
                            <svg width="18" height="18" fill="none" stroke="#7c3aed" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        </div>
                        <div class="stat-value">@upcomingEvents</div>
                        <div class="stat-label">Upcoming Events</div>
                        <div class="stat-sub blue">Next: @nextEventDate</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon amber">
                            <svg width="18" height="18" fill="none" stroke="#d97706" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        </div>
                        <div class="stat-value">@pendingVolunteers</div>
                        <div class="stat-label">Pending Volunteers</div>
                        <div class="stat-sub amber">Needs review</div>
                    </div>
                </div>

                <!-- Donation trend chart -->
                <div class="chart-card">
                    <div class="card-header">
                        <span class="card-title">Donation Trends</span>
                        <span class="card-meta">
                            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            Last 6 months
                        </span>
                    </div>
                    <div class="chart-wrap">
                        <div class="chart-y">
                            <span class="y-label">320K</span>
                            <span class="y-label">240K</span>
                            <span class="y-label">160K</span>
                            <span class="y-label">80K</span>
                            <span class="y-label">0K</span>
                        </div>
                        <div class="chart-bars" style="flex:1">
                            @foreach (var m in monthlyData)
                            {
                                <div class="bar-col">
                                    <div class="bar" style="height:@(m.HeightPct)%"></div>
                                    <span class="bar-label">@m.Month</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Bottom grid -->
                <div class="bottom-grid">

                    <!-- Active campaigns -->
                    <div class="campaigns-card">
                        <div class="card-header">
                            <span class="card-title">Active Campaigns</span>
                            <a class="manage-link" href="/ngo/campaigns">Manage →</a>
                        </div>
                        @if (recentCampaigns.Count == 0)
                        {
                            <p style="font-size:13px;color:#9ca3af;padding:20px 0">No campaigns yet. Create your first one!</p>
                        }
                        else
                        {
                            @foreach (var c in recentCampaigns)
                            {
                                var pct = c.GoalAmount > 0
                                    ? (int)Math.Min(100, c.RaisedAmount / c.GoalAmount * 100)
                                    : 0;
                                <div class="campaign-row">
                                    <div class="campaign-top">
                                        <span class="campaign-name">@c.Title</span>
                                        <span class="status-badge @GetStatusClass(c.Status)">@c.Status</span>
                                    </div>
                                    <div class="campaign-donors">@GetDonorCount(c.Id) donors</div>
                                    <div class="progress-bar">
                                        <div class="progress-fill" style="width:@pct%"></div>
                                    </div>
                                    <div class="campaign-amounts">
                                        <span class="raised">PKR @FormatAmount(c.RaisedAmount) raised</span>
                                        <span>Goal: PKR @FormatAmount(c.GoalAmount)</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <!-- Quick actions -->
                    <div class="actions-card">
                        <div class="card-header">
                            <span class="card-title">Quick Actions</span>
                        </div>
                        <div class="action-item" @onclick='() => Navigation.NavigateTo("/ngo/campaigns/new")'>
                            <div class="action-left">
                                <div class="action-icon" style="background:#dcfce7">
                                    <svg width="15" height="15" fill="none" stroke="#16a34a" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                                </div>
                                <span class="action-label">Create New Campaign</span>
                            </div>
                            <span class="action-arrow">›</span>
                        </div>
                        <div class="action-item" @onclick='() => Navigation.NavigateTo("/ngo/events/new")'>
                            <div class="action-left">
                                <div class="action-icon" style="background:#dbeafe">
                                    <svg width="15" height="15" fill="none" stroke="#2563eb" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                </div>
                                <span class="action-label">Add Event</span>
                            </div>
                            <span class="action-arrow">›</span>
                        </div>
                        <div class="action-item" @onclick='() => Navigation.NavigateTo("/ngo/volunteers")'>
                            <div class="action-left">
                                <div class="action-icon" style="background:#fef3c7">
                                    <svg width="15" height="15" fill="none" stroke="#d97706" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                                </div>
                                <span class="action-label">Review Volunteers</span>
                            </div>
                            @if (pendingVolunteers > 0)
                            {
                                <span class="action-badge">@pendingVolunteers</span>
                            }
                            else
                            {
                                <span class="action-arrow">›</span>
                            }
                        </div>
                        <div class="action-item" @onclick='() => Navigation.NavigateTo("/ngo/blogs")'>
                            <div class="action-left">
                                <div class="action-icon" style="background:#ede9fe">
                                    <svg width="15" height="15" fill="none" stroke="#7c3aed" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                </div>
                                <span class="action-label">Write Blog Post</span>
                            </div>
                            <span class="action-arrow">›</span>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
}

@code {

    private NGO?             currentNgo        = null;
    private bool             isLoading         = true;
    private decimal          totalDonations    = 0;
    private int              activeCampaigns   = 0;
    private int              endingSoon        = 0;
    private int              upcomingEvents    = 0;
    private string           nextEventDate     = "—";
    private int              pendingVolunteers = 0;
    private List<Fundraising> recentCampaigns = new();
    private Dictionary<int, int> donorCounts   = new();

    private record MonthBar(string Month, double HeightPct);
    private List<MonthBar> monthlyData = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user      = await UserManager.GetUserAsync(authState.User);

        if (user == null || user.Role != "NGO")
        {
            isLoading = false;
            return;
        }

        currentNgo = await NgoService.GetNGOByUserIdAsync(user.Id);

        if (currentNgo == null)
        {
            isLoading = false;
            return;
        }

        // Load all data
        var fundraisings = await FundraisingService.GetFundraisingsByNgoIdAsync(currentNgo.Id);
        var campaigns    = await CampaignService.GetCampaignsByNgoIdAsync(currentNgo.Id);
        var donations    = await DonationService.GetDonationsByFundraisingIdAsync(currentNgo.Id);

        totalDonations  = fundraisings.Sum(f => f.RaisedAmount) + campaigns.Sum(c => c.RaisedAmount);
        activeCampaigns = fundraisings.Count(f => f.Status == "Active");
        endingSoon      = fundraisings.Count(f => f.Status == "Active" && f.Deadline <= DateTime.UtcNow.AddDays(7));
        recentCampaigns = fundraisings.OrderByDescending(f => f.CreatedAt).Take(5).ToList();

        // Upcoming events from campaigns
        var upcoming = campaigns.Where(c => c.Status == "Upcoming").OrderBy(c => c.CampaignDate).ToList();
        upcomingEvents = upcoming.Count;
        nextEventDate  = upcoming.FirstOrDefault()?.CampaignDate.ToString("MMM d") ?? "—";

        // Pending volunteers across all campaigns
        foreach (var campaign in campaigns)
        {
            var apps = await VolunteerService.GetApplicationsByCampaignIdAsync(campaign.Id);
            pendingVolunteers += apps.Count(a => a.Status == "Pending");
        }

        // Donor counts per fundraising
        foreach (var f in recentCampaigns)
        {
            var d = await DonationService.GetDonationsByFundraisingIdAsync(f.Id);
            donorCounts[f.Id] = d.Count;
        }

        // Monthly chart — last 6 months
        var now    = DateTime.UtcNow;
        var allDon = await DonationService.GetAllDonationsAsync();
        var ngoIds = fundraisings.Select(f => f.Id).ToHashSet();
        monthlyData = Enumerable.Range(0, 6)
            .Select(i =>
            {
                var m     = now.AddMonths(-5 + i);
                var total = allDon
                    .Where(d => d.FundraisingId.HasValue && ngoIds.Contains(d.FundraisingId.Value)
                             && d.DonatedAt.Month == m.Month && d.DonatedAt.Year == m.Year)
                    .Sum(d => d.Amount);
                return new MonthBar(m.ToString("MMM"), (double)total);
            })
            .ToList();

        // Normalise bar heights to 100%
        var maxVal = monthlyData.Max(m => m.HeightPct);
        if (maxVal > 0)
            monthlyData = monthlyData.Select(m => m with { HeightPct = m.HeightPct / maxVal * 100 }).ToList();

        isLoading = false;
    }

    private async Task HandleLogout()
    {
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private string GetInitial() =>
        currentNgo?.Name?.FirstOrDefault().ToString().ToUpper() ?? "N";

    private string FormatAmount(decimal amount) =>
        amount >= 1_000_000 ? $"{amount / 1_000_000:0.#}M"
        : amount >= 1_000   ? $"{amount / 1_000:0.#}K"
        : amount.ToString("0");

    private string GetStatusClass(string status) => status switch
    {
        "Active"    => "status-active",
        "Completed" => "status-completed",
        _           => "status-upcoming"
    };

    private int GetDonorCount(int fundraisingId) =>
        donorCounts.TryGetValue(fundraisingId, out var c) ? c : 0;
}
