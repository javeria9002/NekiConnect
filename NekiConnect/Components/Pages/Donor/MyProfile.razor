@page "/donor/profile"
@layout DonorLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using NekiConnect.Models
@attribute [Authorize(Roles = "Donor")]
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>My Profile – NekiConnect</PageTitle>

<h2 class="donor-page-title">My Profile</h2>
<p class="donor-page-subtitle">Update your personal information</p>

@if (saved)
{
    <div class="alert-success">✓ Profile updated successfully!</div>
}

<div class="profile-card">
    <div class="form-group">
        <label class="form-label">Full Name</label>
        <input @bind="fullName" class="form-input" />
    </div>
    <div class="form-group">
        <label class="form-label">Email</label>
        <input value="@currentUser?.Email" disabled class="form-input disabled" />
    </div>
    <div class="form-group">
        <label class="form-label">City</label>
        <input @bind="city" class="form-input" />
    </div>
    <div class="form-group">
        <label class="form-label">Bio</label>
        <textarea @bind="bio" rows="4" class="form-textarea"></textarea>
    </div>
    <button @onclick="SaveProfile" class="btn-save">Save Changes</button>
</div>

@code {
    ApplicationUser? currentUser;
    string fullName = "", city = "", bio = "";
    bool saved = false;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUser = await UserManager.GetUserAsync(auth.User);
        if (currentUser == null) { Nav.NavigateTo("/login"); return; }
        fullName = currentUser.FullName;
        city = currentUser.City ?? "";
        bio = currentUser.Bio ?? "";
    }

    async Task SaveProfile()
    {
        if (currentUser == null) return;
        currentUser.FullName = fullName;
        currentUser.City = city;
        currentUser.Bio = bio;
        await UserManager.UpdateAsync(currentUser);
        saved = true;
    }
}