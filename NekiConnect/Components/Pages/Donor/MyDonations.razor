@page "/donor/donations"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using NekiConnect.Models
@using NekiConnect.Services
@attribute [Authorize(Roles = "Donor")]
@inject UserManager<ApplicationUser> UserManager
@inject DonationService DonationService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>My Donations – NekiConnect</PageTitle>

<div class="donor-layout">
    <div class="donor-sidebar">
        <div class="donor-sidebar-profile">
            <div class="donor-avatar">@(currentUser?.FullName?.Substring(0, 1).ToUpper() ?? "D")</div>
            <div class="donor-sidebar-name">@currentUser?.FullName</div>
            <div class="donor-sidebar-role">Donor Account</div>
        </div>
        <nav class="donor-nav">
            <a href="/donor/dashboard">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                Dashboard
            </a>
            <a href="/donor/donations" class="active">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                My Donations
            </a>
            <a href="/donor/applications">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                Volunteer Applications
            </a>
            <a href="/donor/profile">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                My Profile
            </a>
        </nav>
        <div class="donor-logout">
            <form method="post" action="/Account/Logout">
                <AntiforgeryToken />
                <button type="submit">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                    Logout
                </button>
            </form>
        </div>
    </div>

    <div class="donor-content">
        <h2 class="donor-page-title">My Donations</h2>
        <p class="donor-page-subtitle">Your complete donation history</p>

        @if (success == "stripe")
        {
            <div class="alert-success">Stripe payment successful! Your donation has been saved.</div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert-error">Payment could not be processed. Please try again.</div>
        }

        <div class="summary-grid">
            <div class="summary-card">
                <div class="summary-label">Total Donated</div>
                <div class="summary-value green">PKR @totalDonated.ToString("N0")</div>
            </div>
            <div class="summary-card">
                <div class="summary-label">Total Donations</div>
                <div class="summary-value dark">@donations.Count</div>
            </div>
            <div class="summary-card">
                <div class="summary-label">This Month</div>
                <div class="summary-value blue">PKR @thisMonth.ToString("N0")</div>
            </div>
        </div>

        <div class="table-card">
            <div class="table-header">All Donations</div>
            @if (donations.Any())
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Campaign</th>
                            <th>NGO</th>
                            <th>Amount</th>
                            <th>Method</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (d, i) in donations.Select((x, i) => (x, i + 1)))
                        {
                            <tr>
                                <td class="muted">@i</td>
                                <td class="bold">@(d.Campaign?.Title ?? "General")</td>
                                <td>@(d.Campaign?.NGO?.Name ?? "—")</td>
                                <td class="green">PKR @d.Amount.ToString("N0")</td>
                                <td><span class="method-tag">@d.PaymentMethod</span></td>
                                <td class="muted">@d.DonatedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty">No donations yet. <a href="/campaigns">Browse campaigns</a></div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? success { get; set; }

    [SupplyParameterFromQuery]
    public string? error { get; set; }

    ApplicationUser? currentUser;
    List<Donation> donations = new();
    decimal totalDonated, thisMonth;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUser = await UserManager.GetUserAsync(auth.User);
        if (currentUser == null) { Nav.NavigateTo("/login"); return; }
        donations = await DonationService.GetDonationsByDonorIdAsync(currentUser.Id);
        totalDonated = await DonationService.GetTotalDonatedAsync(currentUser.Id);
        thisMonth = await DonationService.GetThisMonthDonatedAsync(currentUser.Id);
    }
}