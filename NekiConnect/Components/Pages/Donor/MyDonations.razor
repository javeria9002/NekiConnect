@page "/donor/donations"
@layout DonorLayout
@using Microsoft.AspNetCore.Authorization
@using NekiConnect.Models
@attribute [Authorize(Roles = "Donor")]
@inject IDonationService DonationService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>My Donations – NekiConnect</PageTitle>

<h2 class="donor-page-title">My Donations</h2>
<p class="donor-page-subtitle">Your complete donation history</p>

@if (success == "stripe")
{
    <div class="alert-success">✓ Stripe payment successful! Your donation has been saved.</div>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="alert-error">⚠ Payment could not be processed. Please try again.</div>
}

<div class="summary-grid">
    <div class="summary-card">
        <div class="summary-label">Total Donated</div>
        <div class="summary-value green">PKR @totalDonated.ToString("N0")</div>
    </div>
    <div class="summary-card">
        <div class="summary-label">Total Donations</div>
        <div class="summary-value dark">@donations.Count</div>
    </div>
    <div class="summary-card">
        <div class="summary-label">This Month</div>
        <div class="summary-value blue">PKR @thisMonth.ToString("N0")</div>
    </div>
</div>

<div class="table-card">
    <div class="table-header">All Donations</div>
    @if (donations.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Campaign</th>
                    <th>NGO</th>
                    <th>Amount</th>
                    <th>Method</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (d, i) in donations.Select((x, i) => (x, i + 1)))
                {
                    <tr>
                        <td class="muted">@i</td>
                        <td class="bold">@(d.Campaign?.Title ?? "General")</td>
                        <td>@(d.Campaign?.NGO?.Name ?? "—")</td>
                        <td class="green">PKR @d.Amount.ToString("N0")</td>
                        <td><span class="method-tag">@d.PaymentMethod</span></td>
                        <td class="muted">@d.DonatedAt.ToString("MMM dd, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty">No donations yet. <a href="/campaigns">Browse campaigns</a></div>
    }
</div>

@code {
    [SupplyParameterFromQuery] public string? success { get; set; }
    [SupplyParameterFromQuery] public string? error { get; set; }

    List<Donation> donations = new();
    decimal totalDonated, thisMonth;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();

        // ✅ Read userId from JWT claims — avoids DbContext conflict with UserManager
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userId)) { Nav.NavigateTo("/login"); return; }

        // ✅ Run all three DB calls in parallel — faster and no concurrency issue
        var t1 = DonationService.GetDonationsByDonorIdAsync(userId);
        var t2 = DonationService.GetTotalDonatedAsync(userId);
        var t3 = DonationService.GetThisMonthDonatedAsync(userId);

        await Task.WhenAll(t1, t2, t3);

        donations = t1.Result;
        totalDonated = t2.Result;
        thisMonth = t3.Result;
    }
}