@page "/donor/applications"
@layout DonorLayout
@using Microsoft.AspNetCore.Authorization
@using NekiConnect.Models
@attribute [Authorize(Roles = "Donor")]
@inject IVolunteerService VolunteerService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Volunteer Applications – NekiConnect</PageTitle>

<h2 class="donor-page-title">Volunteer Applications</h2>
<p class="donor-page-subtitle">Track all your volunteer applications</p>

<div class="table-card">
    @if (applications.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Campaign</th>
                    <th>NGO</th>
                    <th>Skills</th>
                    <th>Applied</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in applications)
                {
                    <tr>
                        <td class="bold">@(a.Campaign?.Title ?? a.Event?.Title ?? "Application")</td>
                        <td>@(a.Campaign?.NGO?.Name ?? a.Event?.NGO?.Name ?? "—")</td>
                        <td>@a.Skills</td>
                        <td class="muted">@a.AppliedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            <span class="badge badge-@a.Status.ToLower()">@a.Status</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty">
            No applications yet.
            <a href="/campaigns">Browse campaigns to volunteer</a>
        </div>
    }
</div>

@code {
    List<VolunteerApplication> applications = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();

        // ✅ Get userId from JWT claims directly — avoids DbContext conflict with UserManager
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userId)) { Nav.NavigateTo("/login"); return; }

        applications = await VolunteerService.GetApplicationsByUserIdAsync(userId);
    }
}