@inherits LayoutComponentBase
@using NekiConnect.Models
@inject IAdminService AdminService
@inject NavigationManager Nav

<div class="admin-layout">
    <div class="admin-sidebar">
        <div class="admin-sidebar-profile">
            <div class="admin-avatar">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
            </div>
            <div class="admin-sidebar-name">Super Admin</div>
            <div class="admin-sidebar-role">Platform Control Panel</div>
        </div>

        <nav class="admin-nav">
            <a href="/admin/dashboard" class="@IsActive("/admin/dashboard")">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                </svg>
                Dashboard
            </a>
            <a href="/admin/ngo-requests" class="@IsActive("/admin/ngo-requests")">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M3 21h18" />
                    <path d="M5 21V7l8-4v18" />
                    <path d="M19 21V11l-6-4" />
                </svg>
                NGO Requests
                @if (pendingNGOs > 0)
                {
                    <span class="admin-nav-badge">@pendingNGOs</span>
                }
            </a>
            <a href="/admin/users" class="@IsActive("/admin/users")">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
                All Users
            </a>
            <a href="/admin/donations" class="@IsActive("/admin/donations")">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                </svg>
                All Donations
            </a>
            <a href="/admin/ngos" class="@IsActive("/admin/ngos")">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M3 21h18" />
                    <path d="M5 21V7l8-4v18" />
                    <path d="M19 21V11l-6-4" />
                </svg>
                All NGOs
            </a>
        </nav>

        <div class="admin-logout">
            <a href="/account/logout">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Logout
            </a>
        </div>
    </div>

    <div class="admin-content">
        @Body
    </div>
</div>

@code {
    private int pendingNGOs;

    protected override async Task OnInitializedAsync()
    {
        pendingNGOs = await AdminService.GetPendingNGOsCountAsync();
    }

    private string IsActive(string path) =>
        Nav.Uri.Contains(path) ? "active" : "";
}