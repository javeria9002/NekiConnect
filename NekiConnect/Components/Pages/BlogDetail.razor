@page "/blog/{Id:int}"
@rendermode InteractiveServer
@inject BlogService BlogService
@inject NavigationManager Navigation

<PageTitle>@(blog?.Title ?? "Blog") — NekiConnect</PageTitle>

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #f9fafb; color: #111827; }

    .nav { display:flex; align-items:center; justify-content:space-between; padding:0 2rem; height:56px; background:#fff; border-bottom:1px solid #e5e7eb; position:sticky; top:0; z-index:100; }
    .brand { display:flex; align-items:center; gap:8px; font-size:15px; font-weight:700; color:#111; cursor:pointer; }
    .brand-icon { width:28px; height:28px; background:#16a34a; border-radius:8px; display:flex; align-items:center; justify-content:center; }
    .brand em { color:#16a34a; font-style:normal; }
    .nav-links { display:flex; align-items:center; gap:26px; list-style:none; }
    .nav-links a { font-size:13.5px; color:#374151; text-decoration:none; font-weight:500; cursor:pointer; }
    .nav-links a:hover { color:#16a34a; }
    .nav-actions { display:flex; align-items:center; gap:10px; }
    .btn-login { background:none; border:none; font-size:13.5px; font-weight:500; color:#374151; cursor:pointer; padding:6px 12px; font-family:'Segoe UI',sans-serif; }
    .btn-reg { background:#16a34a; color:white; border:none; font-size:13.5px; font-weight:600; padding:7px 18px; border-radius:7px; cursor:pointer; font-family:'Segoe UI',sans-serif; }
    .btn-reg:hover { background:#15803d; }

    .breadcrumb { padding:14px 2rem; font-size:13px; color:#6b7280; background:#fff; border-bottom:1px solid #f3f4f6; }
    .breadcrumb a { color:#16a34a; text-decoration:none; cursor:pointer; }
    .breadcrumb a:hover { text-decoration:underline; }
    .breadcrumb span { margin:0 6px; color:#d1d5db; }

    .page { max-width:720px; margin:0 0 0 2rem; padding:40px 20px 80px; }

    /* Back button */
    .back-btn { display:inline-flex; align-items:center; gap:6px; font-size:13px; color:#6b7280; background:none; border:none; cursor:pointer; padding:0; margin-bottom:24px; font-family:'Segoe UI',sans-serif; }
    .back-btn:hover { color:#16a34a; }

    /* Category tag */
    .tag { display:inline-block; font-size:11.5px; font-weight:600; padding:3px 12px; border-radius:20px; margin-bottom:16px; }
    .tag-Impact    { background:#dcfce7; color:#15803d; }
    .tag-Guide     { background:#dbeafe; color:#1d4ed8; }
    .tag-Story     { background:#fce7f3; color:#be185d; }
    .tag-Report    { background:#fef3c7; color:#92400e; }
    .tag-Awareness { background:#ede9fe; color:#6d28d9; }

    /* Title */
    .blog-title { font-size:30px; font-weight:700; color:#111827; line-height:1.3; margin-bottom:20px; }

    /* Author row */
    .author-row { display:flex; align-items:center; gap:12px; padding:16px 0; border-top:1px solid #f3f4f6; border-bottom:1px solid #f3f4f6; margin-bottom:32px; }
    .avatar { width:40px; height:40px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:16px; font-weight:700; color:white; background:#16a34a; flex-shrink:0; }
    .author-info { display:flex; flex-direction:column; gap:2px; }
    .author-name { font-size:14px; font-weight:600; color:#111827; }
    .author-meta { font-size:12.5px; color:#6b7280; display:flex; align-items:center; gap:8px; }
    .dot-sep { width:3px; height:3px; border-radius:50%; background:#d1d5db; }

    /* Cover image */
    .cover-img { width:100%; border-radius:12px; margin-bottom:32px; max-height:380px; object-fit:cover; }

    /* Blog body */
    .blog-body { font-size:15.5px; color:#374151; line-height:1.9; white-space:pre-wrap; word-break:break-word; }

    /* Footer actions */
    .blog-footer { margin-top:48px; padding-top:24px; border-top:1px solid #e5e7eb; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; }
    .back-to-blogs { display:inline-flex; align-items:center; gap:6px; background:#f3f4f6; color:#374151; border:none; padding:9px 18px; border-radius:8px; font-size:13.5px; font-weight:500; cursor:pointer; font-family:'Segoe UI',sans-serif; }
    .back-to-blogs:hover { background:#e5e7eb; }
    .share-label { font-size:13px; color:#6b7280; }

    /* Not found */
    .not-found { text-align:center; padding:80px 20px; }
    .not-found h2 { font-size:22px; color:#374151; margin-bottom:10px; }
    .not-found p { font-size:14px; color:#9ca3af; margin-bottom:24px; }
    .btn-go-back { background:#16a34a; color:white; border:none; padding:10px 24px; border-radius:8px; font-size:14px; font-weight:600; cursor:pointer; font-family:'Segoe UI',sans-serif; }

    .loading { text-align:center; padding:80px; color:#9ca3af; font-size:14px; }
</style>

<Navbar />

<div class="breadcrumb">
    <a @onclick='() => Navigation.NavigateTo("/")'>Home</a>
    <span>›</span>
    <a @onclick='() => Navigation.NavigateTo("/blogs")'>Blogs</a>
    <span>›</span>
    @(blog?.Title ?? "Article")
</div>

<div class="page">
    @if (isLoading)
    {
        <div class="loading">Loading article...</div>
    }
    else if (blog == null)
    {
        <div class="not-found">
            <h2>Blog post not found</h2>
            <p>This article may have been removed or the link is incorrect.</p>
            <button class="btn-go-back" @onclick='() => Navigation.NavigateTo("/blogs")'>
                ← Back to Blogs
            </button>
        </div>
    }
    else
    {
        <!-- Back button -->
        <button class="back-btn" @onclick='() => Navigation.NavigateTo("/blogs")'>
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M19 12H5M12 5l-7 7 7 7"/>
            </svg>
            Back to Blogs
        </button>

        <!-- Category tag -->
        <div>
            <span class="tag @GetTagClass()">@GetTag()</span>
        </div>

        <!-- Title -->
        <h1 class="blog-title">@blog.Title</h1>

        <!-- Author row -->
        <div class="author-row">
            <div class="avatar" style="background:@GetAvatarColor()">
                @GetInitial()
            </div>
            <div class="author-info">
                <span class="author-name">@GetNgoName()</span>
                <div class="author-meta">
                    <span>@blog.CreatedAt.ToString("MMMM dd, yyyy")</span>
                    <span class="dot-sep"></span>
                    <span>@GetReadTime() min read</span>
                </div>
            </div>
        </div>

        <!-- Cover image if exists -->
        @if (!string.IsNullOrEmpty(blog.ImageUrl))
        {
            <img class="cover-img" src="@blog.ImageUrl" alt="@blog.Title" />
        }

        <!-- Full blog content -->
        <div class="blog-body">@blog.Content</div>

        <!-- Footer -->
        <div class="blog-footer">
            <button class="back-to-blogs" @onclick='() => Navigation.NavigateTo("/blogs")'>
                ← Back to Blogs
            </button>
            <span class="share-label">Published by @GetNgoName()</span>
        </div>
    }
</div>

@code {

    [Parameter]
    public int Id { get; set; }

    private BlogPost? blog     = null;
    private bool      isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        blog      = await BlogService.GetBlogByIdAsync(Id);
        isLoading = false;
    }

    private string GetNgoName()    => blog?.NGO?.Name ?? "NekiConnect";
    private string GetInitial()    => blog?.NGO?.Name?.FirstOrDefault().ToString().ToUpper() ?? "N";
    private string GetTag()        => string.IsNullOrEmpty(blog?.Category) ? "Impact" : blog.Category;
    private int    GetReadTime()   => Math.Max(1, (blog?.Content ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Length / 200);

    private string GetTagClass() => GetTag() switch
    {
        "Guide"     => "tag-Guide",
        "Story"     => "tag-Story",
        "Report"    => "tag-Report",
        "Awareness" => "tag-Awareness",
        _           => "tag-Impact"
    };

    private string GetAvatarColor()
    {
        var colors = new[] { "#16a34a", "#2563eb", "#9333ea", "#ea580c", "#0891b2", "#dc2626" };
        return blog == null ? "#16a34a" : colors[Math.Abs((blog.NgoId - 1) % colors.Length)];
    }
}