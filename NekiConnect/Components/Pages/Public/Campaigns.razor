@page "/campaigns"
@using NekiConnect.Models
@using System.Net.Http.Headers
@using System.Text
@using System.Text.Json
@inject ICampaignService CampaignService
@inject ITokenService TokenService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@rendermode InteractiveServer

<Navbar />

<PageTitle>Campaigns – NekiConnect</PageTitle>

<div class="campaigns-page">
    <div class="campaigns-header">
        <h1 class="campaigns-title">Active Campaigns</h1>
        <p class="campaigns-subtitle">Support a cause that matters to you</p>
    </div>

    @if (campaigns.Any())
    {
        <div class="campaigns-grid">
            @foreach (var c in campaigns)
            {
                var progress = c.GoalAmount > 0 ? (double)(c.RaisedAmount / c.GoalAmount * 100) : 0;
                <div class="campaign-card">
                    @if (!string.IsNullOrEmpty(c.ImageUrl))
                    {
                        <img src="@c.ImageUrl" class="campaign-img" alt="@c.Title" />
                    }
                    else
                    {
                        <div class="campaign-img-placeholder">
                            <svg width="40" height="40" fill="none" stroke="#9ca3af" stroke-width="1.5" viewBox="0 0 24 24">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                            </svg>
                        </div>
                    }
                    <div class="campaign-body">
                        <div class="campaign-ngo">@(c.NGO?.Name ?? "NGO")</div>
                        <div class="campaign-name">@c.Title</div>
                        <div class="campaign-desc">@(c.Description.Length > 100 ? c.Description.Substring(0, 100) + "..." : c.Description)</div>

                        <div class="campaign-progress-bar">
                            <div class="campaign-progress-fill" style="width:@Math.Min(progress, 100)%"></div>
                        </div>
                        <div class="campaign-amounts">
                            <span class="raised">PKR @c.RaisedAmount.ToString("N0") raised</span>
                            <span class="goal">of PKR @c.GoalAmount.ToString("N0")</span>
                        </div>

                        <div class="campaign-meta">
                            <span>📍 @c.Location</span>
                            <span>📅 @c.CampaignDate.ToString("MMM dd, yyyy")</span>
                        </div>

                        @if (currentUserRole == "Donor")
                        {
                            <button class="btn-donate" @onclick='() => Nav.NavigateTo($"/campaign/{c.Id}")'>Donate Now</button>
                        }
                        else if (string.IsNullOrEmpty(currentUserId))
                        {
                            <button class="btn-donate" @onclick='() => Nav.NavigateTo("/login?tab=donor")'>
                                Login to Donate
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">No active campaigns at the moment.</div>
    }
</div>

@code {
    List<Campaign> campaigns = new();
    string currentUserId = "";
    string currentUserRole = "";

    protected override async Task OnInitializedAsync()
    {
        campaigns = await CampaignService.GetAllActiveCampaignsAsync();

        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        // ✅ Read from JWT claims — no UserManager, no DbContext conflict
        currentUserId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        currentUserRole = auth.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    }
}