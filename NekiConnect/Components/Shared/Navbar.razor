@inject NavigationManager Navigation

<nav class="nav">
    <a class="brand" href="/">
        <div class="brand-icon">
            <svg width="16" height="16" fill="white" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
            </svg>
        </div>
        NekiConnect
    </a>

    <ul class="nav-links">
        <li><a href="/campaigns" class="@IsActive("/campaigns")">Campaigns</a></li>
        <li><a href="/events" class="@IsActive("/events")">Events</a></li>
        <li><a href="/blogs" class="@IsActive("/blogs")">Blogs</a></li>
        <li>
            <div class="portals-wrap">
                <button class="portals-btn @(PortalsOpen ? "open" : "")" @onclick="TogglePortals">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                    </svg>
                    Portals
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M6 9l6 6 6-6" />
                    </svg>
                </button>

                <div class="portals-grid @(PortalsOpen ? "show" : "")">

                    <div class="portal-item" @onclick='() => GoToPortal("/login?tab=ngo&returnUrl=/ngo/dashboard")'>
                        <div class="portal-icon green">
                            <svg width="16" height="16" fill="none" stroke="#16a34a" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                <polyline points="9 22 9 12 15 12 15 22" />
                            </svg>
                        </div>
                        <div>
                            <div class="portal-label">NGO Dashboard</div>
                            <div class="portal-sub">Manage campaigns & volunteers</div>
                        </div>
                    </div>

                    <div class="portal-divider"></div>

                    <div class="portal-item" @onclick='() => GoToPortal("/login?tab=donor&returnUrl=/donor/dashboard")'>
                        <div class="portal-icon blue">
                            <svg width="16" height="16" fill="none" stroke="#2563eb" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M20 12V22H4V12" />
                                <path d="M22 7H2v5h20V7z" />
                                <path d="M12 22V7" />
                                <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z" />
                                <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z" />
                            </svg>
                        </div>
                        <div>
                            <div class="portal-label">Donor Dashboard</div>
                            <div class="portal-sub">View donations & history</div>
                        </div>
                    </div>

                    <div class="portal-divider"></div>

                    <div class="portal-item" @onclick='() => GoToPortal("/login?tab=admin&returnUrl=/admin/dashboard")'>
                        <div class="portal-icon red">
                            <svg width="16" height="16" fill="none" stroke="#be185d" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                            </svg>
                        </div>
                        <div>
                            <div class="portal-label">Admin Panel</div>
                            <div class="portal-sub">Platform administration</div>
                        </div>
                    </div>

                </div>
            </div>
        </li>
        <li><a href="/ngos" class="@IsActive("/ngos")">NGOs</a></li>
    </ul>

    <div class="nav-actions">
        <button class="btn-login" @onclick='() => Navigation.NavigateTo("/login")'>Login</button>
        <button class="btn-reg" @onclick='() => Navigation.NavigateTo("/register")'>Register</button>
    </div>
</nav>

@code {
    private bool PortalsOpen = false;

    private void TogglePortals() => PortalsOpen = !PortalsOpen;

    private void GoToPortal(string url)
    {
        PortalsOpen = false;
        Navigation.NavigateTo(url);
    }

    private string IsActive(string path)
    {
        var current = Navigation.Uri;
        return current.Contains(path, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }
}