@inject NavigationManager Navigation

<style>
    .nav { display:flex; align-items:center; justify-content:space-between; padding:0 3rem; height:84px; background:#fff; border-bottom:1.5px solid #e5e7eb; position:sticky; top:0; z-index:100; }
    .brand { display:flex; align-items:center; gap:12px; font-size:22.5px; font-weight:700; color:#111; cursor:pointer; text-decoration:none; }
    .brand-icon { width:42px; height:42px; background:#16a34a; border-radius:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .brand-icon svg { width:24px; height:24px; }
    .brand em { color:#16a34a; font-style:italic; }
    .nav-links { display:flex; align-items:center; gap:39px; list-style:none; }
    .nav-links a { font-size:20px; color:#374151; text-decoration:none; font-weight:500; cursor:pointer; transition:color .15s; }
    .nav-links a:hover { color:#16a34a; }
    .nav-links a.active { color:#16a34a; font-weight:600; }
    .nav-actions { display:flex; align-items:center; gap:15px; }
    .btn-login { background:none; border:none; font-size:20px; font-weight:500; color:#374151; cursor:pointer; padding:9px 18px; border-radius:9px; font-family:inherit; transition:color .15s; }
    .btn-login:hover { color:#16a34a; }
    .btn-reg { background:#16a34a; color:white; border:none; font-size:20px; font-weight:600; padding:10.5px 27px; border-radius:10.5px; cursor:pointer; font-family:inherit; transition:background .15s; }
    .btn-reg:hover { background:#15803d; }
</style>

<nav class="nav">
    <a class="brand" href="/">
        <div class="brand-icon">
            <svg width="16" height="16" fill="white" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
            </svg>
        </div>
        Neki<em>Connect</em>
    </a>

    <ul class="nav-links">
        <li><a href="/campaigns" class="@IsActive("/campaigns")">Campaigns</a></li>
        <li><a href="/fundraisings" class="@IsActive("/fundraisings")">Fundraising</a></li>
        <li><a href="/blogs" class="@IsActive("/blogs")">Blogs</a></li>
    </ul>

    <div class="nav-actions">
        <button class="btn-login" @onclick='() => Navigation.NavigateTo("/login")'>Login</button>
        <button class="btn-reg" @onclick='() => Navigation.NavigateTo("/register")'>Register</button>
    </div>
</nav>

@code {
    // Automatically highlights the active link based on current URL
    private string IsActive(string path)
    {
        var current = Navigation.Uri;
        return current.Contains(path, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }
}
